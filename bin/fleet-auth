#!/usr/bin/env bash
# fleet-auth: the AUTH desk's sign-ins, auth log and hand-offs (lib/fleet_auth.py; `fleet-auth -h`).
# bin/fleet dispatches `fleet auth ...` here. Writes only under $FLEET_STATE/auth/ (and the DECIDE or asking lane inbox).
set -eu
SELF=$0
while [ -L "$SELF" ]; do
  _l=$(readlink "$SELF"); case $_l in /*) SELF=$_l ;; *) SELF=$(dirname "$SELF")/$_l ;; esac
done
ROOT=$(cd "$(dirname "$SELF")/.." && pwd -P)
exec python3 "$ROOT/lib/fleet_auth.py" "$@"
