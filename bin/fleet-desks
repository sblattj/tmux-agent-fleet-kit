#!/usr/bin/env bash
# fleet-desks: bring up the four standing desks in two split windows (docs/design/four-desks.md section 5.1). Dispatched as `fleet desks`.
#
#   fleet desks up [--cli C] [--model M] [--dir D] [--handoff DIR] [--no-proof] [--dry-run]
#
# Builds two split windows in the fleet session, each desk an LLM lane (mode desk, never parked):
#   deskA   ROUTE (left, role route) | DECIDE (right, role decide)
#   deskB   WATCH (left, role watch) | LEARN (right, role learn); WATCH and LEARN get a read-only look-for-work brief
#           plus a non-LLM pane under WATCH running `fleet watch status` (tagged @fleet-watch-status 1). It opens
#           only with a WATCH desk this run launched, once per session (a live one is left alone), so a fleet whose
#           desks are all live already is not touched.
# Every desk pane is tagged @fleet-desk <role>. Idempotent: a desk whose roster pane is live is left alone, so a rerun
# on a live fleet prints '<D> already live' four times and launches nothing. Every run (live desks too) then puts
# window deskA at tmux index 0 and deskB at 1: a window already there swaps to the desk's old index, and no pane or
# window id changes. Lanes open at index 2 and up (fleet launch). A dead desk is relaunched into its
# pair's window: a dead right desk splits right of the live left one, a dead left desk splits beside the live right
# one and is swapped to the left.
# Never touches other lanes: a live ORCHESTRATOR or DECISIONS (pre-desks names) keeps its window, pane, roster
# entry and inbox; the new desks start beside it under their own names.
# --handoff DIR (migration from pre-kit desks, issue #9): each desk this run launches starts on its predecessor's
# handoff, DIR/<DESK>.md, else the retired name's file (ROUTE <- ORCHESTRATOR.md, DECIDE <- DECISIONS.md,
# WATCH <- LISTENER.md); its brief names the file and tells it to read it first. A desk already live is left alone.
# Refused while a pre-kit ORCHESTRATOR, DECISIONS or LISTENER still has a live pane in the roster: retire it into a
# handoff first, so two decision desks never answer at once. A desk with no file in DIR starts on its plain brief.
# ---
set -euo pipefail

SESSION=${FLEET_TMUX_SESSION:-fleet}
SOCKET=${FLEET_TMUX_SOCKET:-}
STATE=${FLEET_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet}
HUMAN=${FLEET_HUMAN:-the human}
ROSTER=$STATE/roster.json
BINDIR=$(cd "$(dirname "$0")" && pwd -P)
FLEET=$BINDIR/fleet

usage() { sed -n '2,/^# ---$/{/^# ---$/d;s/^# \{0,1\}//;p;}' "$0"; exit 2; }
die() { printf 'FAIL %s\n' "$*" >&2; exit 1; }
tm() { if [ -n "$SOCKET" ]; then tmux -L "$SOCKET" "$@"; else tmux "$@"; fi; }
roster_get() { [ -s "$ROSTER" ] || return 0; jq -r --arg n "$1" --arg f "$2" '.[$n][$f] // empty' "$ROSTER" 2>/dev/null || true; }
pane_alive() { [ -n "${1:-}" ] && tm list-panes -a -F '#{pane_id} #{pane_dead}' 2>/dev/null | grep -qx "$1 0"; }
live() { pane_alive "$(roster_get "$1" pane)"; } # name -> 0 when its roster pane is a live tmux pane

[ "${1:-}" = up ] || usage
shift
cli=claude model= dir= noproof=0 dry=0 hdir=
while [ $# -gt 0 ]; do
  case $1 in
    --cli) [ $# -ge 2 ] || usage; cli=$2; shift 2 ;;
    --model) [ $# -ge 2 ] || usage; model=$2; shift 2 ;;
    --dir) [ $# -ge 2 ] || usage; dir=$2; shift 2 ;;
    --handoff) [ $# -ge 2 ] || usage; hdir=$2; shift 2 ;;
    --no-proof) noproof=1; shift ;;
    --dry-run) dry=1; shift ;;
    -h|--help) usage ;;
    *) die "unknown argument $1" ;;
  esac
done
command -v jq >/dev/null 2>&1 || die "missing dependency: jq"
command -v tmux >/dev/null 2>&1 || die "missing dependency: tmux"
[ -n "$dir" ] || dir=${FLEET_DIR:-$PWD}
[ -d "$dir" ] || die "directory does not exist: $dir"
if [ -n "$hdir" ]; then
  [ -d "$hdir" ] || die "--handoff: not a directory: $hdir"
  hdir=$(cd "$hdir" && pwd -P)
  for old in ORCHESTRATOR DECISIONS LISTENER; do
    ! live "$old" || die "--handoff: pre-kit desk $old is still live (pane $(roster_get "$old" pane)); retire it into a handoff first (fleet handoff $old, then fleet stop $old) so two desks never answer at once"
  done
fi

lopts=(--cli "$cli" --dir "$dir")
[ -z "$model" ] || lopts+=(--model "$model")
[ "$noproof" = 0 ] || lopts+=(--no-proof)

run() { if [ "$dry" = 1 ]; then printf 'would run:'; printf ' %q' "$@"; printf '\n'; else "$@"; fi; }

created=0 watch_launched=0
if ! tm has-session -t "=$SESSION" 2>/dev/null; then created=1; fi

brief_ROUTE="You are ROUTE, the standing routing desk for $HUMAN. Follow your role file: route work, own the lane lifecycle, never edit files. Never set a /goal."
brief_DECIDE="You are DECIDE, the standing decisions desk for $HUMAN. Load the running-the-decisions-desk skill and run it. Never set a /goal."
brief_WATCH="You are WATCH, a standing desk for $HUMAN. Follow your role file. Look for work, read-only: peer_list for lanes that look stuck or quiet, peer_inbox for events nobody picked up. Report each finding to DECIDE in one short message (peer_send, or decision_open for an ask). Never edit files, never message ROUTE. Never set a /goal."
brief_LEARN="You are LEARN, a standing desk for $HUMAN. Follow your role file. Look for work, read-only: read $STATE/decisions-log.jsonl and finished lanes' goal files and list what you would card, each with its source and a verbatim quote, in your pane of window deskB. Never edit files. Never set a /goal."

handoff_for() { # desk -> its predecessor's handoff file in --handoff DIR, or nothing
  local d=$1 f old
  [ -n "$hdir" ] || return 0
  case $d in ROUTE) old=ORCHESTRATOR ;; DECIDE) old=DECISIONS ;; WATCH) old=LISTENER ;; *) old= ;; esac
  for f in "$hdir/$d.md" ${old:+"$hdir/$old.md"}; do
    if [ -s "$f" ]; then printf '%s' "$f"; return 0; fi
  done
}

launch_desk() { # desk [extra fleet launch args...]
  local d=$1 r b text hf; shift
  r=$(printf '%s' "$d" | tr A-Z a-z); b=brief_$d; text=${!b}
  hf=$(handoff_for "$d")
  if [ -n "$hf" ]; then
    text="$text Your predecessor's handoff is $hf: read it first and carry on from it (open items, routes, pending answers)."
    echo "$d picks up handoff $hf"
  fi
  run "$FLEET" launch "${lopts[@]}" --role "$r" "$@" "$d" desk "$text"
  [ "$d" != WATCH ] || watch_launched=1
  [ "$dry" = 1 ] || tm set-option -p -t "$(roster_get "$d" pane)" @fleet-desk "$r"
}

pair() { # window left right: one split window, left desk | right desk
  local w=$1 l=$2 r=$3 changed=0
  [ "$dry" = 0 ] || echo "window $w: $l (left) | $r (right)"
  if live "$l"; then echo "$l already live (pane $(roster_get "$l" pane))"
  elif live "$r"; then  # half-dead pair: open the left desk beside the live right one, then swap it to the left
    launch_desk "$l" --split-right-of "$r"
    [ "$dry" = 1 ] || tm swap-pane -d -s "$(roster_get "$l" pane)" -t "$(roster_get "$r" pane)"
    changed=1
  else launch_desk "$l"; changed=1
  fi
  if live "$r"; then echo "$r already live (pane $(roster_get "$r" pane))"
  else launch_desk "$r" --split-right-of "$l"; changed=1
  fi
  [ "$dry" = 1 ] || [ "$changed" = 0 ] || tm rename-window -t "$(roster_get "$l" pane)" "$w"
}

status_pane() { # the WATCH window's non-LLM pane: `fleet watch status`, split under the WATCH desk
  local wp sp
  [ "$watch_launched" = 1 ] || { echo "WATCH desk not launched by this run: no WATCH status pane"; return 0; }
  if [ "$dry" = 1 ]; then
    echo "window deskB: WATCH status pane under WATCH"
    printf 'would run: tmux split-window -v -d -l 12 -t <WATCH pane> %q\n' "$FLEET watch status"
    return 0
  fi
  wp=$(roster_get WATCH pane)
  pane_alive "$wp" || { echo "no live WATCH desk: no WATCH status pane"; return 0; }
  sp=$(tm list-panes -s -t "=$SESSION" -F '#{pane_id} #{pane_dead} #{@fleet-watch-status}' 2>/dev/null | awk '$2==0 && $3==1 {print $1; exit}')
  if [ -n "$sp" ]; then echo "WATCH status pane already live (pane $sp)"; return 0; fi
  sp=$(tm split-window -v -d -l 12 -t "$wp" -P -F '#{pane_id}' \
    "env FLEET_STATE=$(printf %q "$STATE") $(printf %q "$FLEET") watch status")
  tm set-option -p -t "$sp" @fleet-watch-status 1
  tm select-pane -t "$sp" -T WATCH-status
  echo "OK WATCH status pane $sp"
}

slot() { # window left-desk index: move the desk window to that tmux window index; pane and window ids never change
  local w=$1 d=$2 idx=$3 wid cur occ
  if [ "$dry" = 1 ]; then echo "window $w: placed at index $idx"; return 0; fi
  pane_alive "$(roster_get "$d" pane)" || { echo "no live $d: window $w not placed"; return 0; }
  wid=$(tm display-message -p -t "$(roster_get "$d" pane)" '#{window_id}')
  cur=$(tm display-message -p -t "$wid" '#{window_index}')
  [ "$cur" != "$idx" ] || { echo "window $w already at index $idx"; return 0; }
  occ=$(tm list-windows -t "=$SESSION" -F '#{window_index} #{window_id}' | awk -v i="$idx" '$1==i {print $2; exit}')
  if [ -n "$occ" ]; then tm swap-window -d -s "$wid" -t "$occ"  # the window that sat there takes the desk's old index
  else tm move-window -d -s "$wid" -t "=$SESSION:$idx"
  fi
  echo "OK window $w moved to index $idx"
}

pair deskA ROUTE DECIDE
pair deskB WATCH LEARN
status_pane

# fleet launch opened the session with a `home` window; drop it once deskA and deskB exist
if [ "$created" = 1 ] && [ "$dry" = 0 ]; then tm kill-window -t "=$SESSION:home" 2>/dev/null || true; fi

# deskA always sits at window index 0 and deskB at 1 (lanes open at 2 and up, see fleet launch); the human's
# current window stays current (swap-window moves focus even with -d, so select it back)
active=
[ "$dry" = 1 ] || active=$(tm display-message -p -t "=$SESSION:" '#{window_id}' 2>/dev/null || true)
slot deskA ROUTE 0
slot deskB WATCH 1
[ -z "$active" ] || tm select-window -t "$active" 2>/dev/null || true
[ "$dry" = 1 ] || echo "OK desks up: deskA ROUTE=$(roster_get ROUTE pane) | DECIDE=$(roster_get DECIDE pane), deskB WATCH=$(roster_get WATCH pane) | LEARN=$(roster_get LEARN pane)"
