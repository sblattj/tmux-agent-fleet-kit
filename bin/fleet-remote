#!/usr/bin/env bash
# fleet remote: reach the fleet tmux session from a phone or tablet over a private overlay (ZeroTier, Tailscale,
# any VPN that gives this host a private address), with ssh + mosh. It never opens anything to the public internet.
#
#   fleet remote setup [--pubkey KEY|FILE] [--ip ADDR] [--dry-run]
#       idempotent: authorized_keys (dir 700, file 600), a key-only sshd drop-in validated with sshd -t before sshd
#       is switched on (rolled back on failure), sshd on (macOS Remote Login, systemd on Linux), the real mosh-server
#       binary allowed in the macOS firewall, window-size latest on the fleet tmux server. Root steps go through sudo
#       (an askpass dialog when there is no TTY); --dry-run prints them and changes nothing.
#   fleet remote status [--ip ADDR]   read-only: sshd, key-only auth, mosh-server PATH, firewall, overlay IP, window-size, sleep
#   fleet remote qr [--read-only] [--ip ADDR]   the attach command for Blink Shell / Termius, plus a QR code (qrencode)
#   fleet remote off [--dry-run] [--keep-sshd]  remove the drop-in; turn sshd off unless it was on before setup
#   fleet remote root-script FILE|-   write setup's root steps to a script for the human to run with sudo (never runs sudo)
#   fleet remote verify               unprivileged: sshd listening, the drop-in, ssh localhost tmux -V, mosh-server, firewall
#   fleet remote ssh-path [--check|--brew-bin]   tmux and mosh-server on the non-interactive ssh PATH; the dir to add
#   fleet remote add-key KEY|FILE [--dry-run]    append a phone key to ~/.ssh/authorized_keys (no sudo)
#   fleet remote attach-line [--read-only] [--ip ADDR]   just the attach command
#
# NEVER expose the tmux socket over raw TCP (socat, ncat, port forwards): anyone who reaches that port runs commands
# as you, with no authentication. Use ssh/mosh only; they run tmux as you after key auth.
#
# env: FLEET_REMOTE_IP (overlay address), FLEET_TMUX_SOCKET / FLEET_TMUX_SESSION (attach target), FLEET_STATE.
# FLEET_REMOTE_SANDBOX=DIR (tests): every system path resolves under DIR (DIR/etc/ssh, DIR/bin/<tool>), and a tool
# missing from DIR/bin is an error, never a fall-through to the real one.
set -u

die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
say()  { printf '==> %s\n' "$*"; }
ok()   { printf '    ok: %s\n' "$*"; }
warn() { printf '    warn: %s\n' "$*"; }
plan() { printf '    [dry-run] would: %s\n' "$*"; }
usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

SB=${FLEET_REMOTE_SANDBOX:-}
OS=${FLEET_REMOTE_OS:-$(uname -s)}
STATE=${FLEET_STATE:-$HOME/.local/state/fleet}
SESSION=${FLEET_TMUX_SESSION:-fleet}
SOCKET=${FLEET_TMUX_SOCKET:-}

if [ -n "$SB" ]; then
  [ -d "$SB/bin" ] || die "FLEET_REMOTE_SANDBOX=$SB has no bin/"
  SSHDIR=$SB/etc/ssh
else
  SSHDIR=/etc/ssh
fi
DROPIN=$SSHDIR/sshd_config.d/010-fleet-remote-keyonly.conf
DROPIN_BODY='# Managed by `fleet remote` (tmux-agent-fleet-kit): key-only ssh for attaching to the fleet session.
# Sorts before most distro drop-ins; sshd keeps the first value it reads.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no'

tool() { # tool <name>: the absolute path to a system tool (sandbox: DIR/bin/<name> or an error)
  local n=$1 p
  if [ -n "$SB" ]; then
    [ -x "$SB/bin/$n" ] || die "sandbox has no bin/$n"
    printf '%s\n' "$SB/bin/$n"; return
  fi
  case $n in
    sshd) p=/usr/sbin/sshd ;;
    systemsetup) p=/usr/sbin/systemsetup ;;
    socketfilterfw) p=/usr/libexec/ApplicationFirewall/socketfilterfw ;;
    launchctl) p=/bin/launchctl ;;
    osascript) p=/usr/bin/osascript ;;
    *) p=$(command -v "$n" 2>/dev/null) || p= ;;
  esac
  [ -n "$p" ] || die "$n not found"
  printf '%s\n' "$p"
}
have() { if [ -n "$SB" ]; then [ -x "$SB/bin/$1" ]; else command -v "$1" >/dev/null 2>&1; fi; }
tm() { if [ -n "$SOCKET" ]; then tmux -L "$SOCKET" "$@"; else tmux "$@"; fi; }

DRY=0
SUDO_READY=0
SUDO=()
ASKPASS=
cleanup() { [ -z "$ASKPASS" ] || rm -f "$ASKPASS"; }
trap cleanup EXIT

ensure_sudo() { # once, on the first root step: sudo, or sudo -A with an askpass dialog when there is no TTY
  [ $SUDO_READY = 1 ] && return 0
  local s; s=$(tool sudo) || exit 1
  SUDO=("$s")
  if ! "$s" -n true 2>/dev/null && [ ! -t 0 ] && [ "$OS" = Darwin ]; then
    local osa; osa=$(tool osascript) || exit 1
    ASKPASS=$(mktemp "${TMPDIR:-/tmp}/fleet-askpass.XXXXXX")
    printf '#!/bin/sh\n%s -e %s -e %s 2>/dev/null\n' "$osa" \
      "'display dialog \"sudo password for fleet remote setup:\" default answer \"\" with hidden answer with title \"fleet remote\"'" \
      "'text returned of result'" > "$ASKPASS"
    chmod 700 "$ASKPASS"
    export SUDO_ASKPASS=$ASKPASS
    SUDO=("$s" -A)
  fi
  "${SUDO[@]}" -v || die "sudo failed"
  SUDO_READY=1
}
run_root() { # run_root <description> <cmd...>: printed under --dry-run, else run through sudo
  local desc=$1; shift
  [ -n "${1:-}" ] || exit 1  # a tool lookup already printed why
  if [ $DRY = 1 ]; then plan "$desc: sudo $*"; return 0; fi
  ensure_sudo
  "${SUDO[@]}" "$@"
}
write_root() { # write_root <file> <mode>: stdin to a root-owned file
  local f=$1 mode=$2
  if [ $DRY = 1 ]; then plan "write $f (mode $mode):"; sed 's/^/        /'; return 0; fi
  ensure_sudo
  "${SUDO[@]}" mkdir -p "$(dirname "$f")" && "${SUDO[@]}" tee "$f" >/dev/null && "${SUDO[@]}" chmod "$mode" "$f"
}

realpath_of() { python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"; }

overlay_ip() { # prints "IP KIND" for the first overlay address found, else nothing
  if [ -n "${IP_ARG:-}" ]; then printf '%s given\n' "$IP_ARG"; return; fi
  if [ -n "${FLEET_REMOTE_IP:-}" ]; then printf '%s FLEET_REMOTE_IP\n' "$FLEET_REMOTE_IP"; return; fi
  local ip
  if have tailscale; then
    ip=$("$(tool tailscale)" ip -4 2>/dev/null | head -1)
    [ -n "$ip" ] && { printf '%s tailscale\n' "$ip"; return; }
  fi
  # interface scan: zt*/feth* carry ZeroTier, an address in 100.64.0.0/10 is Tailscale's CGNAT range
  local lines=
  if have ifconfig; then
    lines=$("$(tool ifconfig)" 2>/dev/null | awk '/^[a-z0-9]+:/{i=$1; sub(":","",i)} /^[ \t]+inet /{print i, $2}')
  elif have ip; then
    lines=$("$(tool ip)" -o -4 addr show 2>/dev/null | awk '{split($4,a,"/"); print $2, a[1]}')
  fi
  printf '%s\n' "$lines" | awk '
    $1 ~ /^(zt|feth)/ { print $2, "zerotier"; exit }
    { split($2, o, "."); if (o[1] == 100 && o[2] >= 64 && o[2] <= 127) { print $2, "tailscale"; exit } }'
}

sshd_listening() { "$(tool nc)" -z -w 2 127.0.0.1 "${FLEET_REMOTE_SSH_PORT:-22}" >/dev/null 2>&1; }

mosh_paths() { # sets MOSH_LINK, MOSH_REAL, MOSH_ON_DEFAULT_PATH (1 when a non-login ssh shell finds it)
  MOSH_LINK=$(command -v mosh-server 2>/dev/null) || MOSH_LINK=
  MOSH_REAL=
  MOSH_ON_DEFAULT_PATH=0
  [ -n "$MOSH_LINK" ] || return 1
  MOSH_REAL=$(realpath_of "$MOSH_LINK")
  case $(dirname "$MOSH_LINK") in /usr/bin|/bin|/usr/sbin|/sbin) MOSH_ON_DEFAULT_PATH=1 ;; esac
  return 0
}

state_file() { printf '%s\n' "$STATE/remote.json"; }

# The PATH a phone's `ssh host cmd` / `mosh host -- cmd` gets: sshd's default (/usr/bin:/bin:/usr/sbin:/sbin), plus
# whatever the login shell's non-interactive startup adds (zsh reads ~/.zshenv; bash -c reads nothing). Homebrew's
# bin dir (/opt/homebrew/bin, /usr/local/bin) is not on it by default, so a bare `tmux` or `mosh-server` fails there.
# FLEET_REMOTE_SSH_SHELL / FLEET_REMOTE_SSH_BASEPATH override the shell and sshd's base PATH (tests).
ssh_path_find() { # ssh_path_find <tool>: its path on the non-interactive ssh PATH, else nothing (exit 1)
  local sh=${FLEET_REMOTE_SSH_SHELL:-${SHELL:-/bin/sh}} base=${FLEET_REMOTE_SSH_BASEPATH:-/usr/bin:/bin:/usr/sbin:/sbin}
  env -i HOME="$HOME" USER="$(id -un)" LOGNAME="$(id -un)" SHELL="$sh" PATH="$base" "$sh" -c "command -v $1" 2>/dev/null \
    | tail -1 | grep . 
}
brew_bin() { # the bin dir that holds this host's tmux/mosh-server when they come from Homebrew or similar
  local p
  if have brew && p=$("$(tool brew)" --prefix 2>/dev/null) && [ -n "$p" ]; then printf '%s/bin\n' "$p"; return; fi
  p=$(command -v tmux 2>/dev/null) && dirname "$p"
}
ssh_path_report() { # prints ok/warn lines for tmux and mosh-server on the non-interactive ssh PATH; sets SSH_PATH_OK
  local n f missing=
  SSH_PATH_OK=1
  for n in tmux mosh-server; do
    if f=$(ssh_path_find "$n"); then ok "$n on the non-interactive ssh PATH: $f"
    else missing="$missing $n"; SSH_PATH_OK=0; fi
  done
  [ "$SSH_PATH_OK" = 1 ] && return 0
  local bb; bb=$(brew_bin)
  warn "not on the non-interactive ssh PATH:$missing (sshd starts commands with /usr/bin:/bin:/usr/sbin:/sbin)"
  warn "the attach line below uses full paths, so it works anyway; to make a bare \`ssh <host> 'tmux -V'\` work too,"
  warn "add this line to ~/.zshenv (zsh) or put it where your login shell reads it for \`ssh host cmd\` (fleet remote never edits shell files):"
  printf '        export PATH="%s:$PATH"\n' "${bb:-/opt/homebrew/bin}"
}


attach_cmd() { # attach_cmd <ip> <readonly 0|1>
  local ip=$1 ro=$2 user tmuxbin server='' tmx
  user=$(id -un)
  tmuxbin=$(command -v tmux 2>/dev/null || echo tmux)
  mosh_paths || true
  [ "$MOSH_ON_DEFAULT_PATH" = 1 ] || [ -z "$MOSH_LINK" ] || server="--server=$MOSH_LINK "
  case $(dirname "$tmuxbin") in /usr/bin|/bin) tmx=tmux ;; *) tmx=$tmuxbin ;; esac
  [ -z "$SOCKET" ] || tmx="$tmx -L $SOCKET"
  local ro_flag=; [ "$ro" = 1 ] && ro_flag=" -r"
  printf 'mosh %s%s@%s -- %s attach -t %s%s\n' "$server" "$user" "$ip" "$tmx" "$SESSION" "$ro_flag"
}

add_key() { # add_key <KEY|FILE|empty>: append an ssh public key to ~/.ssh/authorized_keys once (dir 700, file 600)
  local arg=$1 ssh_dir=$HOME/.ssh ak=$HOME/.ssh/authorized_keys
  if [ -n "$arg" ]; then
    local key
    if [ -f "$arg" ]; then key=$(head -1 "$arg"); else key=$arg; fi
    key=$(printf '%s' "$key" | tr -d '\r\n')
    local fp; fp=$(printf '%s\n' "$key" | ssh-keygen -l -f - 2>/dev/null | awk '{print $2}')
    [ -n "$fp" ] || die "not a valid ssh public key"
    local blob; blob=$(printf '%s\n' "$key" | awk '{print $1" "$2}')
    if [ -f "$ak" ] && awk '{print $1" "$2}' "$ak" | grep -qxF -- "$blob"; then
      ok "key $fp already present"
    elif [ $DRY = 1 ]; then
      plan "append key $fp to ~/.ssh/authorized_keys"
    else
      mkdir -p "$ssh_dir" && chmod 700 "$ssh_dir"
      touch "$ak" && chmod 600 "$ak"
      if [ -s "$ak" ] && [ -n "$(tail -c1 "$ak")" ]; then printf '\n' >> "$ak"; fi
      printf '%s\n' "$key" >> "$ak"
      ok "appended key $fp"
    fi
  else
    ok "no --pubkey; authorized_keys untouched"
  fi
  if [ $DRY = 0 ] && [ -d "$ssh_dir" ]; then chmod 700 "$ssh_dir"; [ ! -f "$ak" ] || chmod 600 "$ak"; fi
}

raw_tcp_warning() {
  printf '    never expose the tmux socket over raw TCP (socat, ncat, port forwards): anyone who reaches it runs commands as you\n'
}

# ---------------------------------------------------------------- setup
cmd_setup() {
  local PUBKEY_ARG=
  while [ $# -gt 0 ]; do
    case $1 in
      --pubkey) [ $# -ge 2 ] || die "--pubkey needs KEY or FILE"; PUBKEY_ARG=$2; shift 2 ;;
      --ip) [ $# -ge 2 ] || die "--ip needs ADDR"; IP_ARG=$2; shift 2 ;;
      --dry-run|-n) DRY=1; shift ;;
      -h|--help) usage ;;
      *) die "setup: unknown arg $1" ;;
    esac
  done

  say "preflight"
  mosh_paths || die "mosh-server not found on PATH; install mosh (brew install mosh / apt install mosh)"
  ok "mosh-server: $MOSH_LINK -> $MOSH_REAL"
  command -v tmux >/dev/null 2>&1 || die "tmux not found"
  ssh_path_report
  local oi; oi=$(overlay_ip)
  if [ -n "$oi" ]; then ok "overlay address: ${oi% *} (${oi##* })"; else warn "no overlay address found (ZeroTier or Tailscale joined?); --ip ADDR sets one"; fi
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8*|*utf8*|*UTF8*|*utf-8*) ok "UTF-8 locale" ;;
    *) warn "mosh-server needs a UTF-8 locale on this host (e.g. LANG=en_US.UTF-8)" ;;
  esac

  say "authorized_keys"
  add_key "$PUBKEY_ARG"

  # record whether sshd was on before the first setup, so `off` can leave it as it found it
  local was_on=false; sshd_listening && was_on=true
  if [ $DRY = 0 ] && [ ! -f "$(state_file)" ]; then
    mkdir -p "$STATE"
    printf '{"sshd_was_on_before_setup": %s, "dropin": "%s"}\n' "$was_on" "$DROPIN" > "$(state_file)"
  fi

  say "sshd host keys"
  if ls "$SSHDIR"/ssh_host_*_key.pub >/dev/null 2>&1; then
    ok "host keys present"
  else
    run_root "generate sshd host keys (needed before sshd -t)" "$(tool ssh-keygen)" -A || die "ssh-keygen -A failed"
    [ $DRY = 1 ] || ok "host keys generated"
  fi

  say "sshd drop-in $DROPIN (before sshd is switched on, so passwords are never open)"
  local sshd; sshd=$(tool sshd) || exit 1
  if [ -f "$DROPIN" ] && [ "$(cat "$DROPIN")" = "$DROPIN_BODY" ]; then
    ok "drop-in already in place"
  elif [ $DRY = 1 ]; then
    write_root "$DROPIN" 644 <<<"$DROPIN_BODY"
    plan "validate: sudo $sshd -t, and roll the drop-in back if it fails"
  else
    local backup=
    if [ -f "$DROPIN" ]; then backup=$(mktemp "${TMPDIR:-/tmp}/fleet-dropin.XXXXXX"); cp "$DROPIN" "$backup"; fi
    write_root "$DROPIN" 644 <<<"$DROPIN_BODY" || die "could not write $DROPIN"
    local eff
    if run_root "validate sshd config" "$sshd" -t \
       && eff=$(run_root "effective sshd config" "$sshd" -T 2>/dev/null) \
       && printf '%s\n' "$eff" | grep -qix 'passwordauthentication no'; then
      ok "drop-in installed; sshd -t passed; effective passwordauthentication no"
      [ -z "$backup" ] || rm -f "$backup"
    else
      if [ -n "$backup" ]; then run_root "restore drop-in" cp "$backup" "$DROPIN"; rm -f "$backup"
      else run_root "remove drop-in" rm -f "$DROPIN"; fi
      die "sshd -t failed or password auth is still on (does sshd_config Include sshd_config.d/*.conf?); drop-in rolled back, sshd left as it was"
    fi
  fi

  say "sshd"
  if sshd_listening; then
    ok "sshd already listening"
  elif [ "$OS" = Darwin ]; then
    run_root "turn on Remote Login" "$(tool systemsetup)" -setremotelogin on || true
    if [ $DRY = 0 ] && ! sshd_listening; then
      warn "systemsetup did not take (it often needs Full Disk Access); trying launchctl"
      run_root "enable sshd" "$(tool launchctl)" enable system/com.openssh.sshd
      run_root "start sshd" "$(tool launchctl)" bootstrap system /System/Library/LaunchDaemons/ssh.plist || true
    fi
    [ $DRY = 1 ] || sshd_listening || die "sshd still off: System Settings > General > Sharing > Remote Login, then rerun"
    [ $DRY = 1 ] || ok "sshd listening"
  else
    run_root "enable and start sshd" "$(tool systemctl)" enable --now ssh 2>/dev/null \
      || run_root "enable and start sshd" "$(tool systemctl)" enable --now sshd
    [ $DRY = 1 ] || sshd_listening || die "sshd still off"
    [ $DRY = 1 ] || ok "sshd listening"
  fi

  if [ "$OS" = Darwin ]; then
    say "application firewall: mosh-server"
    local fw; fw=$(tool socketfilterfw) || exit 1
    if "$fw" --listapps 2>/dev/null | grep -qF -- "$MOSH_REAL" \
       && "$fw" --getappblocked "$MOSH_REAL" 2>/dev/null | grep -qi 'permitted'; then
      ok "mosh-server allowed ($MOSH_REAL)"
    else
      run_root "add mosh-server to the firewall" "$fw" --add "$MOSH_REAL"
      run_root "unblock mosh-server" "$fw" --unblockapp "$MOSH_REAL"
    fi
    warn "the firewall allows this exact path; a package upgrade moves it (e.g. a new Homebrew Cellar version), so rerun setup after upgrading mosh"
  else
    say "firewall"
    ok "not changed on $OS; allow UDP 60000-61000 on the overlay interface if a host firewall is on"
  fi


  say "tmux window-size"
  local ws; ws=$(tm show -gv window-size 2>/dev/null) || ws=
  if [ -z "$ws" ]; then
    warn "no tmux server on this socket yet; run setup again once the fleet is up"
  elif [ "$ws" = latest ]; then
    ok "window-size latest"
  elif [ $DRY = 1 ]; then
    plan "tmux set -g window-size latest (now $ws)"
  else
    tm set -g window-size latest && ok "window-size latest (was $ws)"
  fi


  local ip=${oi% *}; [ -n "$ip" ] || ip='<overlay-ip>'
  say "check from the phone (or any ssh client) before the first attach"
  printf '    ssh %s@%s %s   # prints the tmux version; "command not found" means the PATH note above applies\n' \
    "$(id -un)" "$ip" "'tmux -V'"
  printf '    keep the host awake while away (macOS: caffeinate -dims; Linux: systemd-inhibit)\n'
  raw_tcp_warning
  if [ $DRY = 1 ]; then say "dry run: nothing changed"; else say "done"; fi
  say "phone attach line (Blink Shell: paste at the blink> prompt)"
  printf '    %s\n' "$(attach_cmd "$ip" 0)"
}

# ---------------------------------------------------------------- status
cmd_status() {
  while [ $# -gt 0 ]; do
    case $1 in
      --ip) [ $# -ge 2 ] || die "--ip needs ADDR"; IP_ARG=$2; shift 2 ;;
      -h|--help) usage ;;
      *) die "status: unknown arg $1" ;;
    esac
  done
  if sshd_listening; then echo "sshd: listening"; else echo "sshd: off"; fi
  if [ -f "$DROPIN" ]; then echo "drop-in: $DROPIN"; else echo "drop-in: none"; fi
  local eff
  if eff=$("$(tool sudo)" -n "$(tool sshd)" -T 2>/dev/null) && [ -n "$eff" ]; then
    if printf '%s\n' "$eff" | grep -qix 'passwordauthentication no' \
       && printf '%s\n' "$eff" | grep -qix 'kbdinteractiveauthentication no'; then
      echo "auth: key-only (sshd -T)"
    else
      echo "auth: PASSWORDS ALLOWED (sshd -T); run fleet remote setup"
    fi
  else
    echo "auth: unknown (sshd -T needs sudo without a prompt)"
  fi
  echo "note: sshd listens on every interface, not just the overlay; key-only auth is the guard"
  local n f
  for n in tmux mosh-server; do
    if f=$(ssh_path_find "$n"); then echo "ssh PATH $n: $f"; else echo "ssh PATH $n: missing (a bare ssh host '$n ...' fails; the attach line uses full paths)"; fi
  done
  if mosh_paths; then
    if [ "$MOSH_ON_DEFAULT_PATH" = 1 ]; then echo "mosh-server: $MOSH_LINK (on the non-login ssh PATH)"
    else echo "mosh-server: $MOSH_LINK, not on a non-login ssh PATH; attach with --server=$MOSH_LINK (fleet remote qr does)"; fi
  else
    echo "mosh-server: not found"
  fi
  if [ "$OS" = Darwin ]; then
    local fw; fw=$(tool socketfilterfw) || exit 1
    echo "firewall: $("$fw" --getglobalstate 2>/dev/null | head -1)"
    if [ -n "$MOSH_REAL" ]; then
      if "$fw" --getappblocked "$MOSH_REAL" 2>/dev/null | grep -qi permitted; then echo "firewall mosh-server: allowed"
      else echo "firewall mosh-server: not allowed ($MOSH_REAL)"; fi
    fi
  fi
  local oi; oi=$(overlay_ip)
  if [ -n "$oi" ]; then echo "overlay: ${oi% *} (${oi##* })"; else echo "overlay: none found"; fi
  local ws; ws=$(tm show -gv window-size 2>/dev/null) || ws=
  echo "window-size: ${ws:-no tmux server}"
  if [ "$OS" = Darwin ] && have pmset; then
    local sl; sl=$("$(tool pmset)" -g 2>/dev/null | awk '$1=="sleep"{print $2; exit}')
    if [ "${sl:-0}" = 0 ]; then echo "sleep: off"; else echo "sleep: after $sl min; the session drops while asleep (caffeinate -dims)"; fi
  fi
}

# ---------------------------------------------------------------- qr
cmd_qr() {
  local ro=0
  while [ $# -gt 0 ]; do
    case $1 in
      --read-only|-r) ro=1; shift ;;
      --ip) [ $# -ge 2 ] || die "--ip needs ADDR"; IP_ARG=$2; shift 2 ;;
      -h|--help) usage ;;
      *) die "qr: unknown arg $1" ;;
    esac
  done
  local oi ip; oi=$(overlay_ip); ip=${oi% *}
  [ -n "$ip" ] || { warn "no overlay address found; pass --ip ADDR"; ip='<overlay-ip>'; }
  local cmd; cmd=$(attach_cmd "$ip" "$ro")
  echo "$cmd"
  if command -v qrencode >/dev/null 2>&1; then qrencode -t ANSIUTF8 -- "$cmd"
  else echo "(install qrencode for a scannable QR code of this command)"; fi
  echo "Blink Shell: paste it at the blink> prompt. Termius: new host, Use Mosh on, startup command after the --."
  [ "$ro" = 1 ] || echo "read-only attach: fleet remote qr --read-only"
}

# ---------------------------------------------------------------- off
cmd_off() {
  local keep=0
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run|-n) DRY=1; shift ;;
      --keep-sshd) keep=1; shift ;;
      -h|--help) usage ;;
      *) die "off: unknown arg $1" ;;
    esac
  done
  local sf; sf=$(state_file)
  local was_on=unknown
  [ ! -f "$sf" ] || was_on=$(python3 -c 'import json,sys;print(str(json.load(open(sys.argv[1])).get("sshd_was_on_before_setup")).lower())' "$sf" 2>/dev/null || echo unknown)
  say "sshd"
  if [ $keep = 1 ] || [ "$was_on" != false ]; then
    if [ "$was_on" = true ]; then ok "sshd was on before setup; leaving it on"
    elif [ $keep = 1 ]; then ok "--keep-sshd: leaving sshd on"
    else ok "no setup record; leaving sshd as it is (turn it off in System Settings or systemctl)"; fi
  elif sshd_listening || [ $DRY = 1 ]; then
    if [ "$OS" = Darwin ]; then run_root "turn off Remote Login" "$(tool systemsetup)" -f -setremotelogin off
    else run_root "stop sshd" "$(tool systemctl)" disable --now ssh 2>/dev/null || run_root "stop sshd" "$(tool systemctl)" disable --now sshd; fi
  else
    ok "sshd already off"
  fi
  say "drop-in"
  if [ -f "$DROPIN" ]; then
    run_root "remove $DROPIN" rm -f "$DROPIN"
    if sshd_listening; then warn "sshd is still on without the key-only drop-in; check PasswordAuthentication"; fi
  else
    ok "no drop-in"
  fi
  if [ $DRY = 0 ]; then rm -f "$sf"; say "done"; else say "dry run: nothing changed"; fi
}

# ---------------------------------------------------------------- ssh-path / add-key / attach-line (fleet bootstrap)
cmd_ssh_path() { # --check: one line per tool, exit 1 if one is missing; --brew-bin: the dir to put on the ssh PATH
  case ${1:---check} in
    --brew-bin) brew_bin ;;
    --check) local n f rc=0
      for n in tmux mosh-server; do
        if f=$(ssh_path_find "$n"); then echo "ok: $n on the non-interactive ssh PATH: $f"
        else echo "missing: $n is not on the non-interactive ssh PATH"; rc=1; fi
      done; return $rc ;;
    -h|--help) usage ;;
    *) die "ssh-path: unknown arg $1 (--check or --brew-bin)" ;;
  esac
}
cmd_add_key() {
  local k=
  while [ $# -gt 0 ]; do
    case $1 in --dry-run|-n) DRY=1; shift ;; -h|--help) usage ;; *) [ -z "$k" ] || die "add-key: one KEY or FILE"; k=$1; shift ;; esac
  done
  [ -n "$k" ] || die "add-key needs KEY or FILE"
  add_key "$k"
}
cmd_attach_line() {
  local ro=0
  while [ $# -gt 0 ]; do
    case $1 in
      --read-only|-r) ro=1; shift ;;
      --ip) [ $# -ge 2 ] || die "--ip needs ADDR"; IP_ARG=$2; shift 2 ;;
      -h|--help) usage ;;
      *) die "attach-line: unknown arg $1" ;;
    esac
  done
  local oi ip; oi=$(overlay_ip); ip=${oi% *}; [ -n "$ip" ] || ip='<overlay-ip>'
  attach_cmd "$ip" "$ro"
}

# ---------------------------------------------------------------- root-script (fleet bootstrap's sudo half)
# Writes the same root steps setup runs through sudo, as one script for the human to run with sudo: host keys, the
# key-only drop-in checked with sshd -t / sshd -T (rolled back on failure) BEFORE sshd is switched on, sshd on, and
# the mosh-server firewall allow (that per-binary allow is what lets mosh's UDP 60000-61000 in on macOS). Tool paths
# are resolved now (sandbox paths under FLEET_REMOTE_SANDBOX). This command never runs sudo. FILE "-" = stdout.
cmd_root_script() {
  local out=${1:-} q
  [ -n "$out" ] || die "root-script needs FILE (or - for stdout)"
  if ! mosh_paths; then # a dry-run preview before brew installs mosh shows the path it will have; a real write needs it
    [ "$out" = - ] || die "mosh-server not found on PATH; install mosh first (brew install mosh)"
    MOSH_REAL="$(brew_bin || echo /opt/homebrew/bin)/mosh-server"
  fi
  q() { printf '%q' "$1"; }
  local body
  body=$(
    echo '#!/bin/bash'
    echo "# Root steps for tmux-agent-fleet-kit remote attach, written by \`fleet remote root-script\` on $(date -u +%Y-%m-%dT%H:%MZ)."
    echo '# Run it yourself: sudo bash <this file>. Then check without sudo: fleet bootstrap --verify'
    echo '# Idempotent. Rerun it after upgrading mosh: the firewall allow names the exact mosh-server binary.'
    echo 'set -u'
    if [ -z "$SB" ]; then
      echo '[ "$(id -u)" = 0 ] || { echo "run me as root: sudo bash $0" >&2; exit 1; }'
    else
      echo '# sandbox (tests): FLEET_REMOTE_SANDBOX paths, no root check'
    fi
    echo 'say() { printf "==> %s\n" "$*"; }; ok() { printf "    ok: %s\n" "$*"; }; fail() { printf "FAIL %s\n" "$*" >&2; exit 1; }'
    echo "DROPIN=$(q "$DROPIN")"
    echo "SSHDIR=$(q "$SSHDIR")"
    echo "NC=$(q "$(tool nc)") SSHD=$(q "$(tool sshd)") KEYGEN=$(q "$(tool ssh-keygen)")"
    echo "PORT=$(q "${FLEET_REMOTE_SSH_PORT:-22}")"
    echo 'listening() { "$NC" -z -w 2 127.0.0.1 "$PORT" >/dev/null 2>&1; }'
    cat <<'EOS'

say "sshd host keys"
if ls "$SSHDIR"/ssh_host_*_key.pub >/dev/null 2>&1; then ok "host keys present"
else "$KEYGEN" -A || fail "ssh-keygen -A failed"; ok "host keys generated"; fi

say "key-only sshd drop-in $DROPIN (before sshd is switched on, so passwords are never open)"
EOS
    printf "BODY=\$(cat <<'DROPIN_EOF'\n%s\nDROPIN_EOF\n)\n" "$DROPIN_BODY"
    cat <<'EOS'
if [ -f "$DROPIN" ] && [ "$(cat "$DROPIN")" = "$BODY" ]; then
  ok "drop-in already in place"
else
  backup=
  if [ -f "$DROPIN" ]; then backup=$(mktemp); cp "$DROPIN" "$backup"; fi
  mkdir -p "$(dirname "$DROPIN")" && printf '%s\n' "$BODY" > "$DROPIN" && chmod 644 "$DROPIN" || fail "could not write $DROPIN"
  if "$SSHD" -t && "$SSHD" -T 2>/dev/null | grep -qix 'passwordauthentication no'; then
    ok "drop-in installed; sshd -t passed; effective passwordauthentication no"
    [ -z "$backup" ] || rm -f "$backup"
  else
    if [ -n "$backup" ]; then cp "$backup" "$DROPIN"; rm -f "$backup"; else rm -f "$DROPIN"; fi
    fail "sshd -t failed or password auth is still on (does sshd_config Include sshd_config.d/*.conf?); drop-in rolled back, sshd left as it was"
  fi
fi

say "sshd"
if listening; then ok "sshd already listening"
EOS
    if [ "$OS" = Darwin ]; then
      echo "else"
      echo "  $(q "$(tool systemsetup)") -setremotelogin on || true"
      echo "  if ! listening; then"
      echo "    echo '    systemsetup did not take (it often needs Full Disk Access); trying launchctl'"
      echo "    $(q "$(tool launchctl)") enable system/com.openssh.sshd"
      echo "    $(q "$(tool launchctl)") bootstrap system /System/Library/LaunchDaemons/ssh.plist || true"
      echo "  fi"
      echo '  listening || fail "sshd still off: System Settings > General > Sharing > Remote Login, then rerun"'
      echo '  ok "sshd listening (Remote Login on)"'
      echo "fi"
      echo
      echo 'say "application firewall: mosh-server (this per-binary allow is what lets mosh UDP 60000-61000 in)"'
      echo "FW=$(q "$(tool socketfilterfw)") MOSH=$(q "$MOSH_REAL")"
      echo '"$FW" --add "$MOSH" && "$FW" --unblockapp "$MOSH" || fail "firewall allow for $MOSH failed"'
      echo 'ok "mosh-server allowed ($MOSH)"'
    else
      echo "else"
      echo "  $(q "$(tool systemctl)") enable --now ssh 2>/dev/null || $(q "$(tool systemctl)") enable --now sshd"
      echo '  listening || fail "sshd still off"; ok "sshd listening"'
      echo "fi"
      echo
      echo 'say "firewall: mosh UDP 60000-61000"'
      echo 'if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "Status: active"; then ufw allow 60000:61000/udp && ok "ufw allows UDP 60000-61000"'
      echo 'elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then firewall-cmd --permanent --add-port=60000-61000/udp && firewall-cmd --reload && ok "firewalld allows UDP 60000-61000"'
      echo 'else ok "no ufw/firewalld active; nothing to open"; fi'
    fi
    echo
    echo 'say "done; now check it unprivileged: fleet bootstrap --verify"'
  )
  if [ "$out" = - ]; then printf '%s\n' "$body"; return 0; fi
  mkdir -p "$(dirname "$out")"
  printf '%s\n' "$body" > "$out" && chmod 700 "$out"
  # record whether sshd was on before the first root run, so `fleet remote off` can leave it as it found it
  if [ ! -f "$(state_file)" ]; then
    local was_on=false; sshd_listening && was_on=true
    mkdir -p "$STATE"
    printf '{"sshd_was_on_before_setup": %s, "dropin": "%s"}\n' "$was_on" "$DROPIN" > "$(state_file)"
  fi
}

# ---------------------------------------------------------------- verify (no privileges, ever)
cmd_verify() {
  [ "${1:-}" != -h ] && [ "${1:-}" != --help ] || usage
  local bad=0
  if sshd_listening; then echo "ok: sshd: listening"; else echo "FAIL sshd: not listening (run the root script)"; bad=1; fi
  if [ -f "$DROPIN" ] && [ "$(cat "$DROPIN")" = "$DROPIN_BODY" ]; then echo "ok: drop-in: present ($DROPIN)"
  elif [ -f "$DROPIN" ]; then echo "FAIL drop-in: $DROPIN differs from the kit's; rerun the root script"; bad=1
  else echo "FAIL drop-in: missing ($DROPIN)"; bad=1; fi
  # a bare `ssh localhost tmux -V` with the user's own key, when one is authorized: BatchMode (never a prompt), no known_hosts write
  local ak=$HOME/.ssh/authorized_keys pub key= blob
  for pub in "$HOME"/.ssh/id_*.pub; do
    [ -f "$pub" ] && [ -f "${pub%.pub}" ] && [ -f "$ak" ] || continue
    blob=$(awk '{print $1" "$2}' "$pub")
    if awk '{print $1" "$2}' "$ak" | grep -qxF -- "$blob"; then key=${pub%.pub}; break; fi
  done
  if [ -z "$key" ]; then
    echo "skipped: ssh localhost tmux -V (no ~/.ssh/id_* key is in authorized_keys; the phone's key is checked from the phone)"
  else
    local v
    if v=$("$(tool ssh)" -n -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 \
          -o LogLevel=ERROR -i "$key" -p "${FLEET_REMOTE_SSH_PORT:-22}" localhost tmux -V 2>&1) && [ -n "$v" ]; then
      echo "ok: ssh localhost tmux -V: $v"
    else
      echo "FAIL ssh localhost tmux -V: ${v:-no output} (a bare ssh command can't find tmux, or key auth failed)"; bad=1
    fi
  fi
  local f
  if f=$(ssh_path_find mosh-server); then echo "ok: mosh-server on the non-interactive ssh PATH: $f"
  else echo "FAIL mosh-server is not on the non-interactive ssh PATH (fleet bootstrap adds it via ~/.zshenv)"; bad=1; fi
  if [ "$OS" = Darwin ] && mosh_paths; then
    if "$(tool socketfilterfw)" --getappblocked "$MOSH_REAL" 2>/dev/null | grep -qi permitted; then echo "ok: firewall: mosh-server allowed"
    else echo "FAIL firewall: mosh-server not allowed ($MOSH_REAL; rerun the root script after a mosh upgrade)"; bad=1; fi
  fi
  return $bad
}

[ $# -ge 1 ] || usage 1
sub=$1; shift
case $sub in
  setup) cmd_setup "$@" ;;
  status) cmd_status "$@" ;;
  qr) cmd_qr "$@" ;;
  off) cmd_off "$@" ;;
  ssh-path) cmd_ssh_path "$@" ;;
  add-key) cmd_add_key "$@" ;;
  attach-line) cmd_attach_line "$@" ;;
  root-script) cmd_root_script "$@" ;;
  verify) cmd_verify "$@" ;;
  -h|--help|help) usage ;;
  *) usage 1 ;;
esac
