#!/usr/bin/env bash
# fleet: launch and manage a fleet of coding-agent CLIs (claude, codex, opencode, kiro, agy) as tmux windows/panes.
# tafk is the same command under a second name (bin/tafk -> fleet): `tafk <anything>` runs `fleet <anything>`.
#
#   fleet launch [opts] <name> goal   <condition.txt>   first prompt is a /goal condition (living goal JSON)
#   fleet launch [opts] <name> prompt <text|file>       plain first prompt
#   fleet launch [opts] <name> desk   [text|file]       standing decisions desk (never a /goal)
#   fleet launch [opts] <name> resume <session-id>      resume a saved session under the same name
#   fleet ls                                            roster and liveness, one line per lane
#   fleet attach                                        tmux attach to the fleet session
#   fleet decisions serve|tui|pick|ask|find|report|refresh   DECISIONS UI (lib/fleet_decisions.py; `fleet decisions -h`)
#   fleet layout                                        print the tmux window/pane map
#   fleet status-label [FORMAT|--reset]                 the fleet session's status-left: save FORMAT to $FLEET_STATE/status-label and apply it
#                                                       (session scope, length auto-sized); --reset unsets it; no argument shows saved and live;
#                                                       FLEET_STATUS_LABEL overrides the file
#   fleet stop <name> [--keep-sides]                    kill that lane's pane; its running side runs are killed first
#                                                       (or kept as status=orphan with --keep-sides)
#   fleet send <to> <text>                              message a lane (reopens it if parked), sender is $FLEET_NAME
#   fleet listen [--source NAME [ARG]] [--speakers "A,B"] [--page] [--pane-right-of NAME | --here]
#                                                       WATCH UI pane: follow a call, route asks/actions (lib/fleet_listen.py)
#   fleet show IMAGE [--text SUMMARY]                  draw an image in this pane: real image (Kitty placeholders) when every
#                                                       viewer can see it, block art otherwise (mosh), always a text line;
#                                                       FLEET_GFX=auto|kitty|symbols|text; never sets a tmux option (bin/fleet-show)
#   fleet desks up [--cli C] [--model M] [--dir D] [--handoff DIR] [--no-proof] [--dry-run]
#                                                       the standing desks: windows deskA (ROUTE|DECIDE/AUTH), deskB (WATCH|LEARN) (bin/fleet-desks)
#   fleet tick|park|reopen|cleanup|handoff|forget ...   lifecycle, handled by bin/fleet-lifecycle
#   fleet watch run|check|status|stats|serve|webhook ...  WATCH engine: poll sources, route events to DECIDE/LEARN (bin/fleet-watch)
#   fleet ui serve|url [--port P] [--tab T]             one loopback page for every desk: /decide /learn /watch /route,
#                                                       one port, one token (lib/fleet_ui.py); `fleet decisions|learn|watch
#                                                       serve` are aliases: they print the hub URL, or start the hub
#   fleet app urls|serve|notify|tunnel|build|open        Fleet Desk, the Mac app (lib/fleet_app.py, app/desk-ui)
#   fleet learn add|list|show|confirm|drop|sync|lesson|lessons|session|digest|brief|curate|entity|rebuild|sources|due|quiz|review|proof|snapshot|export|serve ...
#                                                       LEARN engine: ledger, quizzes, proof of learning (bin/fleet-learn)
#   fleet auth ask|begin|number|end|unexpected-push|confirm|freeze|thaw|log|trace|status|helpers ...
#                                                       AUTH engine: hand-offs, one sign-in at a time, heads-up to DECIDE,
#                                                       append-only auth log (bin/fleet-auth)
#   fleet probe <verb>|stats|nuked|resume ...           DECIDE read-only probes (bin/fleet-probe)
#   fleet side start|end|ls|show|adopt-ach ...          side runs: a lane's child runs outside tmux (lib/fleet_side.py)
#   fleet feed start URL --token-file PATH [...]|ls|stop N|status N
#                                                       follow a remote call transcript into a local file for fleet listen (lib/fleet_feed.py)
#   fleet remote setup|status|qr|off ...                attach from a phone over ssh+mosh on ZeroTier/Tailscale (bin/fleet-remote)
#   fleet bootstrap [--dry-run] [--verify] [--no-desks] [--cli C] [--pubkey KEY|FILE]
#                                                       new computer: brew tools, CLI installers, ssh PATH, desks; writes the root steps
#                                                       to a script for the human (never sudo); --verify checks them (bootstrap.sh)
#   fleet update [--check] [--dry-run]                  move this kit to the latest release tag: a git checkout fast-forwards
#                                                       (refused when dirty, diverged or offline), a copied tree swaps in the
#                                                       release tarball; then refreshes the bin links and re-renders
#                                                       the rules layer (bin/fleet-update)
#   fleet install CLI [flags]                           run install/CLI.sh (claude|codex|opencode|kiro|agy)
#   fleet rules refresh|uninstall|path [--dry-run] [--cli LIST]  the AGENTS.fleet.md rules layer (install/rules.sh)
#   fleet uninstall [--dry-run] [--cli LIST]            same as fleet rules uninstall
#   fleet version                                       this kit's version (git describe, else the VERSION file)
#
# launch opts:
#   --cli claude|codex|opencode|kiro|agy  which CLI (default claude; agy = Antigravity CLI)
#   --model M                     model (claude default: opus; others: the CLI default)
#   --dir D                       working dir (default $FLEET_DIR, else $PWD)
#   --split right|left|above|below --of NAME
#                                 open as a pane on that side of NAME's pane instead of a new window
#   --split-right-of NAME         same as --split right --of NAME
#   --size PCT                    with a split: the new pane's share of NAME's pane, 1-99 percent
#   --role route|decide|watch|learn|auth|worker|probe
#                                 role context + deny list (default worker; desk mode defaults to decide)
#                                 the old names orchestrator, desk and listener are refused in every mode (renamed route, decide, watch)
#                                 except in resume mode, which fleet reopen uses for live pre-desks lanes;
#                                 probe = DECIDE's read-only probe lane: no shell, no writes, only the fleet-probe
#                                 read verbs; refused (fails closed) on a CLI that can't drop its shell tool
#                                 (`fleet probe can-host <cli>`: claude, opencode, kiro yes; codex, agy no)
#   --keep-tools LIST             claude worker lanes only: comma list of tools to keep out of the worker
#                                 block (Workflow,ScheduleWakeup,ReportFindings, or "all"). By default a claude
#                                 worker lane also disallows those three (about 6k tokens of schemas a lane
#                                 rarely uses). A goal-mode launch also reads keepTools from the goal JSON the
#                                 condition names (for example "keepTools": ["Workflow"] for a goal that
#                                 permits a workflow). Recorded in the roster so fleet reopen keeps it.
#   --env KEY=VALUE               repeatable: an export line in the window script (VALUE shell-quoted, KEY an env
#                                 name, not one fleet sets itself). Stored in launch/<name>.launch.json; a resume
#                                 with no --env reapplies the stored set, and fleet reopen passes it again. The
#                                 claude env proof checks each KEY reached the CLI process.
#                                 FLEET_PRELAUNCH_HOOK=<cmd>: run before launch (dry runs too) with NAME MODE ARG
#                                 (an executable path gets them as args; other text runs in bash -c with $1 $2 $3);
#                                 it prints KEY=VALUE lines to export ('#' and blank lines skipped), --env wins on a
#                                 clash, and a nonzero exit refuses the launch.
#                                 FLEET_STRIP_EXTRA="VAR1 VAR2": appended to the window script's unset line.
#   --dry-run                     print the window script, prompt and tmux command; touch nothing
#   --no-proof                    skip the pid / goal / session waits (tests with stub CLIs); roster is still written
#   --no-desks                    launch even when the roster has no live ROUTE or DECIDE (env twin FLEET_NO_DESKS=1).
#                                 Without it a worker or probe lane (goal, prompt, resume; so fleet reopen too) first runs
#                                 `fleet desks up` (idempotent; --dir and --no-proof passed on), and FAILs with
#                                 "FAIL no desks: ..." if that does not leave ROUTE and DECIDE live. --dry-run prints the step.
#
# goal condition lint: starts with "/goal ", <= 4000 chars, names a *.json goal file, contains "file wins"
# and "stop after". desk text may not start with "/goal".
#
# env: FLEET_TMUX_SESSION (fleet)  FLEET_TMUX_SOCKET (-L socket)  FLEET_STATE (~/.local/state/fleet)
#      FLEET_DIR  FLEET_HUMAN  FLEET_CLAUDE_BIN / FLEET_CODEX_BIN / FLEET_OPENCODE_BIN / FLEET_KIRO_BIN (kiro-cli)
#      KIRO_HOME (~/.kiro; passed to kiro lanes when set)  FLEET_KIRO_GOAL_MAX (20; kiro goal mode sends /goal --max N)
#      FLEET_AGY_BIN (agy)  FLEET_AGY_HOME (~/.gemini: agy's config/ and antigravity-cli/ data; passed to agy lanes when set)
#      FLEET_PROOF_TIMEOUT (90 seconds; also bounds the codex UI wait at 30 and opencode/kiro session wait at 60)
# Every lane runs in bypass/no-approval mode. Failure prints "FAIL <reason>" to stderr and exits 1.
# ---
set -euo pipefail

SKIPVAR=CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS
STRIP="CLAUDE_CODE_CHILD_SESSION CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_AGENT CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_JOB_DIR CLAUDE_PID CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ATTENDED CLAUDE_CODE_EXECPATH"

SESSION=${FLEET_TMUX_SESSION:-fleet}
SOCKET=${FLEET_TMUX_SOCKET:-}
STATE=${FLEET_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet}
AGY_HOME=${FLEET_AGY_HOME:-$HOME/.gemini}
HUMAN=${FLEET_HUMAN:-the human}
PROOF_T=${FLEET_PROOF_TIMEOUT:-90}
ROSTER=$STATE/roster.json
SELF=$0
while [ -L "$SELF" ]; do
  _l=$(readlink "$SELF"); case $_l in /*) SELF=$_l ;; *) SELF=$(dirname "$SELF")/$_l ;; esac
done
BINDIR=$(cd "$(dirname "$SELF")" && pwd -P)
ROOT=$(cd "$BINDIR/.." && pwd -P)

usage() { sed -n '2,/^# ---$/{/^# ---$/d;s/^# \{0,1\}//;p;}' "$0"; exit 2; }
die() { printf 'FAIL %s\n' "$*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
tm() { if [ -n "$SOCKET" ]; then tmux -L "$SOCKET" "$@"; else tmux "$@"; fi; }
LANE_MIN_INDEX=2 # tmux window indexes 0 and 1 are kept for deskA and deskB (bin/fleet-desks)
lane_index() { # the first window index from LANE_MIN_INDEX that no window in $SESSION uses
  tm list-windows -t "=$SESSION" -F '#{window_index}' 2>/dev/null |
    awk -v m="$LANE_MIN_INDEX" '{u[$1]=1} END {i=m; while (i in u) i++; print i}'
}
flog() { mkdir -p "$STATE/log"; printf '%s %s\n' "$(now)" "$*" >> "$STATE/log/fleet.log"; }
role_guard() { # verb : only an unset FLEET_ROLE (the human) or ROUTE may do lane lifecycle
  case "${FLEET_ROLE:-}" in ""|route) ;; *) die "role $FLEET_ROLE can't $1" ;; esac
}
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

pane_alive() {
  local out
  [ -n "${1:-}" ] || return 1
  out=$(tm list-panes -a -F '#{pane_id}' 2>/dev/null || true)
  printf '%s\n' "$out" | grep -qx -- "$1"
}

roster_get() { # name field -> value or empty
  [ -s "$ROSTER" ] || return 0
  jq -r --arg n "$1" --arg f "$2" '.[$n][$f] // empty' "$ROSTER" 2>/dev/null || true
}

roster_merge() { # name json-patch
  local t
  mkdir -p "$STATE"
  [ -s "$ROSTER" ] || printf '{}\n' > "$ROSTER"
  t=$(mktemp "$STATE/.roster.XXXXXX")
  if jq --arg n "$1" --argjson p "$2" '.[$n] = ((.[$n] // {}) + $p)' "$ROSTER" > "$t"; then
    mv "$t" "$ROSTER"
  else
    rm -f "$t"; die "could not update $ROSTER"
  fi
}

new_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then uuidgen | tr 'A-Z' 'a-z'
  elif [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  else python3 -c 'import uuid;print(uuid.uuid4())'; fi
}

free_port() { python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1])'; }

read_arg() { if [ -f "$1" ]; then cat "$1"; else printf '%s' "$1"; fi; }

# poll "<shell command>" seconds : run the command every second until it succeeds or time runs out
poll() {
  local cmd=$1 secs=$2 end
  end=$(( $(date +%s) + secs ))
  while :; do
    if eval "$cmd"; then return 0; fi
    [ "$(date +%s)" -lt "$end" ] || return 1
    sleep 1
  done
}

min() { if [ "$1" -lt "$2" ]; then echo "$1"; else echo "$2"; fi; }

# Worker-lane tool block (claude): schemas a worker lane rarely uses, about 6k tokens per lane start
# (context-diet 2026-11-20, trim 1). Kept tools come from --keep-tools and, in goal mode, the goal
# JSON's keepTools array. Sets $blocked (comma list, may be empty) and $kept (comma list).
WORKER_BLOCK="Workflow ScheduleWakeup ReportFindings"
worker_block() { # mode condition-text keep-flag
  local mode=$1 text=$2 flag=$3 gfile= gkeep= t k all
  kept= blocked=
  if [ "$mode" = goal ]; then
    gfile=$(printf '%s' "$text" | grep -oE '(~|/)[^ "]*\.json' | head -1 || true)
    case $gfile in "~"/*) gfile=$HOME/${gfile#"~"/} ;; esac
    if [ -n "$gfile" ] && [ -r "$gfile" ]; then
      gkeep=$(jq -r 'if (.keepTools|type)=="array" then .keepTools|map(tostring)|join(",") else "" end' "$gfile" 2>/dev/null) \
        || die "goal file $gfile is not valid JSON"
    fi
  fi
  all=",$flag,$gkeep,"
  for k in $(printf '%s' "$flag,$gkeep" | tr ',' ' '); do
    case $k in all|Workflow|ScheduleWakeup|ReportFindings) ;; *) die "--keep-tools/keepTools: unknown tool $k (Workflow|ScheduleWakeup|ReportFindings|all)" ;; esac
  done
  for t in $WORKER_BLOCK; do
    case $all in *",all,"*|*",$t,"*) kept="${kept:+$kept,}$t" ;; *) blocked="${blocked:+$blocked,}$t" ;; esac
  done
}

# ---------------------------------------------------------------- desks guard
claude_home() { printf '%s' "${FLEET_CLAUDE_HOME:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"; }

session_name_pid() { # name -> pid of a live process whose <claude home>/sessions/<pid>.json has name == NAME
  local f p
  for f in $(grep -lF "\"$1\"" "$(claude_home)"/sessions/*.json 2>/dev/null); do
    p=$(jq -r --arg n "$1" 'select(.name == $n) | .pid // empty' "$f" 2>/dev/null) || continue
    case $p in ''|*[!0-9]*) continue ;; esac
    if kill -0 "$p" 2>/dev/null; then printf '%s' "$p"; return 0; fi
  done
  return 0
}

valid_env_name() { printf '%s' "$1" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*$'; }

env_add() { # KEY=VALUE source : append to ENVK/ENVV (a later KEY replaces an earlier one)
  local kv=$1 src=$2 k v i
  case $kv in *=*) ;; *) die "$src: want KEY=VALUE: $kv" ;; esac
  k=${kv%%=*} v=${kv#*=}
  valid_env_name "$k" || die "$src: not an env var name: $k"
  case " FLEET_NAME FLEET_ROLE FLEET_STATE FLEET_TMUX_SESSION FLEET_MESH $SKIPVAR " in
    *" $k "*) die "$src: $k is set by fleet launch itself" ;;
  esac
  for i in ${ENVK[@]+"${!ENVK[@]}"}; do
    if [ "${ENVK[$i]}" = "$k" ]; then ENVV[$i]=$v; return 0; fi
  done
  ENVK+=("$k"); ENVV+=("$v")
}

desks_guard() { # dir noproof dry : bring the desks up when ROUTE or DECIDE has no live pane, or FAIL with the hint
  local d=$1 np=$2 dr=$3 a
  if pane_alive "$(roster_get ROUTE pane)" && pane_alive "$(roster_get DECIDE pane)"; then return 0; fi
  a=(desks up --dir "$d"); [ "$np" = 0 ] || a+=(--no-proof)
  if [ "$dr" = 1 ]; then printf 'would run: fleet'; printf ' %q' "${a[@]}"; printf '  (no live ROUTE or DECIDE)\n'; return 0; fi
  echo "no live ROUTE or DECIDE: bringing the desks up first (fleet desks up)"
  "$BINDIR/fleet" "${a[@]}" >&2 || die "no desks: fleet desks up failed, so no lane launched; run fleet desks up (--cli C), or pass --no-desks"
  pane_alive "$(roster_get ROUTE pane)" && pane_alive "$(roster_get DECIDE pane)" \
    || die "no desks: ROUTE or DECIDE still has no live pane after fleet desks up; run fleet desks up, or pass --no-desks"
}

# ---------------------------------------------------------------- launch
cmd_launch() {
  local cli=claude model= dir= split= splitdir= size= dry=0 noproof=0 role= keep= nodesks=${FLEET_NO_DESKS:-0} envs=()
  while [ $# -gt 0 ]; do
    case $1 in
      --cli) [ $# -ge 2 ] || usage; cli=$2; shift 2 ;;
      --model) [ $# -ge 2 ] || usage; model=$2; shift 2 ;;
      --dir) [ $# -ge 2 ] || usage; dir=$2; shift 2 ;;
      --split-right-of) [ $# -ge 2 ] || usage; split=$2; splitdir=${splitdir:-right}; shift 2 ;;
      --split) [ $# -ge 2 ] || usage; splitdir=$2; shift 2 ;;
      --of) [ $# -ge 2 ] || usage; split=$2; shift 2 ;;
      --size) [ $# -ge 2 ] || usage; size=$2; shift 2 ;;
      --role) [ $# -ge 2 ] || usage; role=$2; shift 2 ;;
      --keep-tools) [ $# -ge 2 ] || usage; keep=$2; shift 2 ;;
      --env) [ $# -ge 2 ] || usage; envs+=("$2"); shift 2 ;;
      --dry-run) dry=1; shift ;;
      --no-proof) noproof=1; shift ;;
      --no-desks) nodesks=1; shift ;;
      -h|--help) usage ;;
      -*) die "unknown flag $1" ;;
      *) break ;;
    esac
  done
  [ $# -ge 2 ] || usage
  local splitflags=
  if [ -n "$splitdir" ] || [ -n "$split" ] || [ -n "$size" ]; then
    [ -n "$split" ] || die "--split $splitdir needs --of NAME"
    case ${splitdir:-right} in
      right) splitflags="-h" ;;
      left) splitflags="-h -b" ;;
      below) splitflags="-v" ;;
      above) splitflags="-v -b" ;;
      *) die "--split must be right, left, above or below: $splitdir" ;;
    esac
    if [ -n "$size" ]; then
      printf '%s' "$size" | grep -Eq '^[1-9][0-9]?$' || die "--size must be a percent 1-99: $size"
      splitflags="$splitflags -l $size%"
    fi
  fi
  local name=$1 mode=$2 arg=${3:-}
  printf '%s' "$name" | grep -Eq '^[A-Za-z0-9._-]+$' || die "name must match [A-Za-z0-9._-]+: $name"
  case $cli in claude|codex|opencode|kiro|agy) ;; *) die "unknown --cli $cli (claude|codex|opencode|kiro|agy)" ;; esac
  need jq
  role_guard launch
  if [ -z "$role" ]; then if [ "$mode" = desk ]; then role=decide; else role=worker; fi; fi
  case $role in
    orchestrator) die "role orchestrator is renamed route (--role route)" ;;  # every mode, resume included (Q110 c)
    desk) die "role desk is renamed decide (--role decide)" ;;
    listener) die "role listener is renamed watch (--role watch)" ;;
  esac
  case $role in route|decide|watch|learn|auth|worker|probe) ;; *) die "unknown --role $role (route|decide|watch|learn|auth|worker|probe)" ;; esac
  if [ "$role" = probe ]; then # fail closed: a probe lane must drop Bash and writes (docs/design/four-desks.md 2.5)
    local why
    why=$(python3 "$ROOT/lib/fleet_probe.py" can-host "$cli" 2>&1) || die "role probe refused on --cli $cli: ${why#NO }"
  fi

  [ -n "$dir" ] || dir=${FLEET_DIR:-$PWD}
  [ -d "$dir" ] || die "directory does not exist: $dir"
  dir=$(cd "$dir" && pwd -P)
  if [ -z "$model" ] && [ "$cli" = claude ]; then model=opus; fi

  local sid= text= resume=0
  case $mode in
    goal)
      [ -f "$arg" ] || die "goal mode needs a condition file"
      text=$(cat "$arg")
      case $text in "/goal "*) ;; *) die "condition must start with '/goal '" ;; esac
      if [ "$cli" = kiro ]; then # Kiro: /goal [--max N] <objective>, default 5 iterations; rewrite before the length check
        local gmax=${FLEET_KIRO_GOAL_MAX:-20}
        printf '%s' "$gmax" | grep -Eq '^[1-9][0-9]*$' || die "FLEET_KIRO_GOAL_MAX must be a positive integer: $gmax"
        text="/goal --max $gmax ${text#/goal }"
      fi
      [ "${#text}" -le 4000 ] || die "condition is ${#text} chars, max 4000"
      case $text in *.json*) ;; *) die "condition does not name a *.json goal file" ;; esac
      case $text in *"file wins"*) ;; *) die "condition lacks 'file wins'" ;; esac
      case $text in *"stop after"*) ;; *) die "condition has no turn bound ('or stop after N turns')" ;; esac ;;
    prompt)
      [ -n "$arg" ] || die "prompt mode needs text or a file"
      text=$(read_arg "$arg") ;;
    desk)
      if [ -n "$arg" ]; then text=$(read_arg "$arg")
      else text="You are $name, the standing decisions desk for $HUMAN. Load the running-the-decisions-desk skill and run it. Never set a /goal."; fi
      case $text in "/goal"*) die "desk sessions never start with /goal (a standing desk cannot meet one)" ;; esac ;;
    resume)
      [ -n "$arg" ] || die "resume needs a session id"
      if [ "$cli" = claude ]; then
        printf '%s' "$arg" | grep -Eq '^[0-9a-f-]{36}$' || die "claude resume needs a session uuid"
      elif [ "$cli" = kiro ]; then
        printf '%s' "$arg" | grep -Eq '^sess_[0-9A-Fa-f-]{36}$' || die "kiro resume needs a session id like sess_<uuid>: $arg"
      elif [ "$cli" = agy ]; then
        printf '%s' "$arg" | grep -Eq '^[0-9a-f-]{36}$' || die "agy resume needs a conversation uuid: $arg"
      else
        printf '%s' "$arg" | grep -Eq '^[A-Za-z0-9_.-]+$' || die "bad session id: $arg"
      fi
      sid=$arg; resume=1 ;;
    *) usage ;;
  esac

  # binary
  local bin binvar
  case $cli in
    claude) binvar=${FLEET_CLAUDE_BIN:-claude} ;;
    codex) binvar=${FLEET_CODEX_BIN:-codex} ;;
    opencode) binvar=${FLEET_OPENCODE_BIN:-opencode} ;;
    kiro) binvar=${FLEET_KIRO_BIN:-kiro-cli} ;;
    agy) binvar=${FLEET_AGY_BIN:-agy} ;;
  esac
  bin=$(command -v "$binvar" 2>/dev/null || true)
  if [ -z "$bin" ]; then
    [ "$dry" = 1 ] || die "$cli binary not found: $binvar (set FLEET_$(printf '%s' "$cli" | tr a-z A-Z)_BIN)"
    bin=$binvar
  fi

  # issue #4: per-lane env. Stored in launch/<name>.launch.json; a resume with no --env reapplies the stored set
  # (fleet reopen passes it as --env). FLEET_PRELAUNCH_HOOK prints more KEY=VALUE lines; --env wins on a clash.
  local ENVK=() ENVV=() e k
  if [ "$resume" = 1 ] && [ "${#envs[@]}" = 0 ] && [ -s "$STATE/launch/$name.launch.json" ]; then
    while IFS= read -r -d '' e; do envs+=("$e"); done < <(jq -j '(.env // {}) | to_entries[] | "\(.key)=\(.value)\u0000"' "$STATE/launch/$name.launch.json" 2>/dev/null)
  fi
  if [ -n "${FLEET_PRELAUNCH_HOOK:-}" ]; then
    local hout hrc=0  # an executable path gets NAME MODE ARG; other text runs in bash -c with $1 $2 $3 set to them
    if [ -f "$FLEET_PRELAUNCH_HOOK" ] && [ -x "$FLEET_PRELAUNCH_HOOK" ]; then
      hout=$("$FLEET_PRELAUNCH_HOOK" "$name" "$mode" "$arg") || hrc=$?
    else
      hout=$(bash -c "$FLEET_PRELAUNCH_HOOK" fleet-prelaunch "$name" "$mode" "$arg") || hrc=$?
    fi
    [ "$hrc" = 0 ] || die "FLEET_PRELAUNCH_HOOK refused the launch of $name (exit $hrc)"
    while IFS= read -r e; do
      case $e in ''|'#'*) continue ;; esac
      env_add "$e" "FLEET_PRELAUNCH_HOOK"
    done <<< "$hout"
  fi
  for e in ${envs[@]+"${envs[@]}"}; do env_add "$e" "--env"; done
  local strip=$STRIP
  for k in ${FLEET_STRIP_EXTRA:-}; do
    valid_env_name "$k" || die "FLEET_STRIP_EXTRA: not an env var name: $k"
    strip="$strip $k"
  done

  # liveness: refuse a second live lane under the same name
  if [ "$dry" = 0 ]; then
    local oldpane
    oldpane=$(roster_get "$name" pane)
    if pane_alive "$oldpane"; then die "a lane named $name is already live (pane $oldpane); fleet stop $name first, or pick another name"; fi
    if [ "$cli" = claude ] && [ "$noproof" = 0 ]; then
      local lp
      lp=$(pgrep -f -- "claude .*-n $name( |\$)" 2>/dev/null | head -1 || true)
      [ -z "$lp" ] || die "a claude named $name is already live (pid $lp); stop it or pick another name"
      # issue #5: a background or hand-resumed session has no -n in argv but registers its name in Claude's
      # sessions/<pid>.json; a live pid there under this name holds it too
      lp=$(session_name_pid "$name")
      [ -z "$lp" ] || die "a claude named $name is already live (pid $lp, $(claude_home)/sessions/$lp.json); stop it or pick another name"
    fi
  fi

  # desks guard (issue #9): a lane reports to ROUTE and asks DECIDE, so it never starts in a fleet with neither.
  # Desk launches (mode desk, desk roles) are exempt: fleet desks up launches them through here.
  if [ "$nodesks" != 1 ] && [ "$mode" != desk ]; then
    case $role in worker|probe) desks_guard "$dir" "$noproof" "$dry" ;; esac
  fi

  [ "$resume" = 1 ] || { [ "$cli" != claude ] || sid=$(new_uuid); }
  [ "$cli" != claude ] || [ -n "$sid" ] || sid=$(new_uuid)

  local port=
  if [ "$cli" = opencode ]; then need python3; port=$(free_port); fi

  local ldir=$STATE/launch
  local sh=$ldir/$name.sh txt=$ldir/$name.txt
  local q_dir q_txt q_bin q_state q_session q_log q_logdir
  q_dir=$(printf '%q' "$dir"); q_txt=$(printf '%q' "$txt"); q_bin=$(printf '%q' "$bin")
  q_state=$(printf '%q' "$STATE"); q_session=$(printf '%q' "$SESSION")
  q_log=$(printf '%q' "$STATE/log/fleet.log"); q_logdir=$(printf '%q' "$STATE/log")

  local rdir=$ROOT/roles
  [ -f "$rdir/$role.md" ] || die "role file missing: $rdir/$role.md"
  local first= cmd= extra= exports= rflags= pre=
  case $cli in
    claude)
      [ -f "$rdir/$role.claude.json" ] || die "role file missing: $rdir/$role.claude.json"
      rflags=" --settings $(printf '%q' "$rdir/$role.claude.json") --append-system-prompt-file $(printf '%q' "$rdir/$role.md")"
      # fleet-mesh per launch: peer_inbox is every lane's mailbox; nothing is written to the user's Claude config
      if [ "$role" = probe ]; then # built-ins cut to read tools; MCP: only the mesh inbox and the fleet-probe verbs
        rflags="$rflags --tools Read,Grep,Glob,WebFetch --strict-mcp-config --mcp-config $(printf '%q' "$(jq -cn --arg m "$ROOT/lib/fleet_mesh.py" --arg p "$ROOT/lib/fleet_probe.py" '{mcpServers:{fleet:{command:"python3",args:[$m,"serve"]},"fleet-probe":{command:"python3",args:[$p,"serve"]}}}')")"
      else
        rflags="$rflags --mcp-config $(printf '%q' "$(jq -cn --arg m "$ROOT/lib/fleet_mesh.py" '{mcpServers:{fleet:{command:"python3",args:[$m,"serve"]}}}')")"
      fi ;;
    codex)
      if [ -f "${CODEX_HOME:-$HOME/.codex}/fleet-$role.config.toml" ]; then rflags=" -p fleet-$role"
      elif [ "$role" = probe ]; then die "codex profile fleet-probe not installed (run install/codex.sh); a probe lane never launches without its allowlist"
      else printf 'warn: codex profile fleet-%s not installed (%s/fleet-%s.config.toml); launching without role %s (run install/codex.sh)\n' "$role" "${CODEX_HOME:-$HOME/.codex}" "$role" "$role" >&2; fi ;;
    opencode)
      if jq -e --arg a "fleet-$role" '.agent[$a] != null' "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json" >/dev/null 2>&1; then rflags=" --agent fleet-$role"
      elif [ "$role" = probe ]; then die "opencode agent fleet-probe not installed (run install/opencode.sh); a probe lane never launches without its allowlist"
      else printf 'warn: opencode agent fleet-%s not installed (%s/opencode/opencode.json); launching without role %s (run install/opencode.sh)\n' "$role" "${XDG_CONFIG_HOME:-$HOME/.config}" "$role" >&2; fi ;;
    kiro)
      if [ -f "${KIRO_HOME:-$HOME/.kiro}/agents/fleet-$role.json" ]; then rflags=" --agent fleet-$role"
      elif [ "$role" = probe ]; then die "kiro agent fleet-probe not installed (run install/kiro.sh); a probe lane never launches without its allowlist"
      else printf 'warn: kiro agent fleet-%s not installed (%s/agents/fleet-%s.json); launching without role %s (run install/kiro.sh)\n' "$role" "${KIRO_HOME:-$HOME/.kiro}" "$role" "$role" >&2; fi ;;
    agy)
      [ -f "$rdir/$role.agy.json" ] || die "role file missing: $rdir/$role.agy.json"
      if [ -f "$AGY_HOME/config/agents/fleet-$role.md" ]; then rflags=" --agent fleet-$role"
      elif [ "$role" = probe ]; then die "agy agent fleet-probe not installed (run install/agy.sh); a probe lane never launches without its allowlist"
      else printf 'warn: agy agent fleet-%s not installed (%s/config/agents/fleet-%s.md); launching without role %s context (deny rules still apply; run install/agy.sh)\n' "$role" "$AGY_HOME" "$role" "$role" >&2; fi ;;
  esac
  if [ "$resume" = 0 ]; then first=" \"\$(cat $q_txt)\""; fi
  local deny=AskUserQuestion blocked= kept=
  if [ "$cli" = claude ] && [ "$role" = worker ]; then
    worker_block "$mode" "$text" "$keep"
    [ -z "$blocked" ] || deny="$deny,$blocked"
  fi
  local agyset= agylog= agytype=
  if [ "$cli" = agy ]; then
    agyset=$ldir/$name.agy-settings.json agylog=$STATE/log/$name.agy.log
    # goal mode types /goal into the TUI: agy sends an -i first prompt as plain text, never as a slash command (PROVEN)
    [ "$mode" != goal ] || agytype=1
  fi
  case $cli in
    claude)
      exports="export $SKIPVAR=1 FLEET_MESH=$(printf '%q' "$ROOT/lib/fleet_mesh.py")"  # role hook mirrors SendMessage
      # issue #5: a standing desk never hands its session to a background job on exit (that job would keep the name)
      case $mode:$role in desk:*|*:route|*:decide|*:watch|*:learn|*:auth) exports="$exports CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF=1" ;; esac
      if [ "$resume" = 1 ]; then
        cmd="$q_bin --dangerously-skip-permissions -n $name --model $model --disallowed-tools=$deny$rflags --resume $sid"
      else
        cmd="$q_bin --dangerously-skip-permissions -n $name --model $model --disallowed-tools=$deny$rflags --session-id $sid --$first"
      fi ;;
    codex)
      cmd="$q_bin --dangerously-bypass-approvals-and-sandbox$rflags"
      [ -z "$model" ] || cmd="$cmd -m $(printf '%q' "$model")"
      cmd="$cmd -C $q_dir"
      if [ "$resume" = 1 ]; then cmd="$cmd resume $sid"; else cmd="$cmd$first"; fi ;;
    opencode)
      cmd="$q_bin --port $port$rflags"
      [ -z "$model" ] || cmd="$cmd -m $(printf '%q' "$model")"
      if [ "$resume" = 1 ]; then cmd="$cmd -s $sid $q_dir"; else cmd="$cmd --prompt \"\$(cat $q_txt)\" $q_dir"; fi ;;
    kiro)
      cmd="$q_bin chat --agent-engine v3 --trust-all-tools --trust-workspace$rflags"
      [ -z "$model" ] || cmd="$cmd --model $(printf '%q' "$model")"
      if [ "$resume" = 1 ]; then cmd="$cmd --resume-id $sid"; else cmd="$cmd$first"; fi ;;
    agy)
      # per-lane --settings (never saved): trust the dir, no prompts, role deny rules; --log-file names the conversation
      cmd="$q_bin --dangerously-skip-permissions --settings $(printf '%q' "$agyset") --log-file $(printf '%q' "$agylog")$rflags"
      [ -z "$model" ] || cmd="$cmd --model $(printf '%q' "$model")"
      if [ "$resume" = 1 ]; then cmd="$cmd --conversation $sid"
      elif [ -z "$agytype" ]; then cmd="$cmd -i \"\$(cat $q_txt)\""; fi ;;
  esac
  [ -z "$SOCKET" ] || extra="$extra FLEET_TMUX_SOCKET=$(printf '%q' "$SOCKET")"
  [ -z "${FLEET_CODEX_BIN:-}" ] || extra="$extra FLEET_CODEX_BIN=$(printf '%q' "$FLEET_CODEX_BIN")"
  [ -z "${FLEET_KIRO_BIN:-}" ] || extra="$extra FLEET_KIRO_BIN=$(printf '%q' "$FLEET_KIRO_BIN")"
  [ -z "${KIRO_HOME:-}" ] || extra="$extra KIRO_HOME=$(printf '%q' "$KIRO_HOME")"
  [ -z "${FLEET_AGY_BIN:-}" ] || extra="$extra FLEET_AGY_BIN=$(printf '%q' "$FLEET_AGY_BIN")"
  [ -z "${FLEET_AGY_HOME:-}" ] || extra="$extra FLEET_AGY_HOME=$(printf '%q' "$FLEET_AGY_HOME")"
  if [ "$cli" = agy ]; then
    pre=": > $(printf '%q' "$agylog")"   # a fresh log per launch, so the proof never reads a stale conversation id
    if [ -n "$agytype" ]; then
      # wait for agy's idle prompt in this pane, type the /goal line, pause so the slash picker settles, then Enter
      pre="$pre
agy_type() {
  local i
  for i in \$(seq 1 120); do
    sleep 1
    if tmux capture-pane -p -t \"\$TMUX_PANE\" 2>/dev/null | grep -qF '? for shortcuts'; then
      tmux send-keys -t \"\$TMUX_PANE\" -l \"\$(tr '\\n' ' ' < $q_txt | sed 's/ *\$//')\"
      sleep 1
      tmux send-keys -t \"\$TMUX_PANE\" Enter
      fl \"$name typed its /goal\"
      return 0
    fi
  done
  fl \"$name: agy prompt not ready after 120 s; /goal not typed\"
}
agy_type &"
    fi
  fi

  local userexp= i
  for i in ${ENVK[@]+"${!ENVK[@]}"}; do userexp="$userexp
export ${ENVK[$i]}=$(printf '%q' "${ENVV[$i]}")"; done
  local body
  body=$(cat <<EOF
#!/usr/bin/env bash
# written by fleet launch $(now): $name ($mode, $cli)
cd $q_dir || exit 1
unset $strip
export FLEET_NAME=$name FLEET_ROLE=$role FLEET_STATE=$q_state FLEET_TMUX_SESSION=$q_session$extra
$exports$userexp
mkdir -p $q_logdir
fl() { printf '%s %s\n' "\$(date -u +%Y-%m-%dT%H:%M:%SZ)" "\$*" >> $q_log; }
fl "$name started cli=$cli mode=$mode role=$role session=${sid:-unknown}"
$pre
$cmd
rc=\$?
fl "$name exited rc=\$rc"
exit \$rc
EOF
)

  local q_sh tmcmd tmprefix=tmux
  q_sh=$(printf '%q' "$sh")
  [ -z "$SOCKET" ] || tmprefix="tmux -L $SOCKET"
  local splitpane=
  if [ -n "$split" ]; then
    splitpane=$(roster_get "$split" pane)
    if [ "$dry" = 0 ]; then
      pane_alive "$splitpane" || die "--split ${splitdir:-right} --of $split: no live pane for $split in the roster"
    fi
    tmcmd="$tmprefix split-window -d $splitflags -P -F '#{pane_id}' -t ${splitpane:-<pane of $split>} -c $q_dir bash $q_sh"
  else
    tmcmd="$tmprefix new-window -d -P -F '#{pane_id}' -t =$SESSION:<first free index from $LANE_MIN_INDEX> -n $name -c $q_dir bash $q_sh"
  fi

  if [ "$dry" = 1 ]; then
    printf '## script %s\n%s\n' "$sh" "$body"
    if [ -n "$text" ]; then printf '## prompt %s (%s chars)\n%s\n' "$txt" "${#text}" "$text"; fi
    if [ "$cli" = agy ]; then printf '## settings %s\n' "$agyset"; agy_settings "$rdir/$role.agy.json" "$dir"; fi
    printf '## tmux %s\n' "$tmcmd"
    return 0
  fi

  need tmux
  mkdir -p "$ldir" "$STATE/log"
  if [ -n "$text" ]; then printf '%s\n' "$text" > "$txt"; fi
  [ "$cli" != agy ] || agy_settings "$rdir/$role.agy.json" "$dir" > "$agyset" || die "could not write $agyset"
  printf '%s\n' "$body" > "$sh"; chmod +x "$sh"

  local marker=
  [ "$cli" != codex ] || marker=$(mktemp "$STATE/.marker.XXXXXX")

  if ! tm has-session -t "=$SESSION" 2>/dev/null; then
    tm new-session -d -s "$SESSION" -n home -c "$dir" || die "could not create tmux session $SESSION"
  fi
  status_label_apply || true  # saved or env label (issue #44); no label means no tmux option call
  passthrough_apply  # allow-passthrough on, server-wide, unless FLEET_DESK_PASSTHROUGH is set to anything but 1
  local pane
  if [ -n "$split" ]; then
    pane=$(tm split-window -d $splitflags -P -F '#{pane_id}' -t "$splitpane" -c "$dir" "bash $q_sh") || die "tmux split-window failed"
  else
    local idx try=0
    while :; do # windows 0 and 1 are deskA and deskB (fleet desks up): a lane takes the first free index from 2
      idx=$(lane_index)
      pane=$(tm new-window -d -P -F '#{pane_id}' -t "=$SESSION:$idx" -n "$name" -c "$dir" "bash $q_sh" 2>/dev/null) && break
      try=$((try + 1)); [ "$try" -lt 5 ] || die "tmux new-window failed (index $idx)"  # lost a race for the index
    done
  fi
  tm select-pane -t "$pane" -T "$name" 2>/dev/null || true
  local panepid at
  panepid=$(tm display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null || true)
  at=$(now)

  roster_merge "$name" "$(jq -n --arg name "$name" --arg cli "$cli" --arg mode "$mode" --arg role "$role" --arg pane "$pane" \
    --arg sid "$sid" --argjson port "${port:-null}" --arg dir "$dir" --arg model "$model" \
    --argjson pid "${panepid:-null}" --arg at "$at" --arg kept "$kept" --arg blocked "$blocked" \
    '{name:$name,cli:$cli,mode:$mode,role:$role,pane:$pane,session_id:(if $sid=="" then null else $sid end),port:$port,dir:$dir,model:(if $model=="" then null else $model end),pid:$pid,at:$at,keepTools:$kept,blockedTools:$blocked}')"
  flog "$name launched cli=$cli mode=$mode pane=$pane"
  local envj='{}'
  for i in ${ENVK[@]+"${!ENVK[@]}"}; do envj=$(jq -c --arg k "${ENVK[$i]}" --arg v "${ENVV[$i]}" '. + {($k): $v}' <<< "$envj"); done
  jq -n --arg name "$name" --arg mode "$mode" --arg cli "$cli" --arg sid "$sid" --arg script "$sh" --arg pane "$pane" --arg at "$at" \
    --argjson env "$envj" \
    '{name:$name,cli:$cli,mode:$mode,pane:$pane,sessionId:$sid,script:$script,at:$at,env:$env}' > "$ldir/$name.launch.json"

  local goal=n/a
  if [ "$mode" = goal ]; then goal=unverified; fi

  if [ "$noproof" = 0 ]; then
    case $cli in
      claude) proof_claude "$name" "$sid" "$pane" "$mode" ;;
      codex) proof_codex "$name" "$pane" "$dir" "$mode" "$marker" ;;
      opencode) proof_opencode "$name" "$port" "$dir" "$mode" ;;
      kiro) proof_kiro "$name" "$pane" "${panepid:-}" "$mode" "$sid" ;;
      agy) proof_agy "$name" "$pane" "$mode" "$sid" "$agylog" ;;
    esac
    [ "$mode" != goal ] || goal=active
    sid=$(roster_get "$name" session_id)
  fi
  [ -z "$marker" ] || rm -f "$marker"
  printf 'OK %s cli=%s mode=%s pane=%s session=%s goal=%s\n' "$name" "$cli" "$mode" "$pane" "${sid:-pending}" "$goal"
}

# ---------------------------------------------------------------- proofs
env_check() { # pid -> sets $miss (empty = all checks passed)
  local env
  miss=
  if [ -r "/proc/$1/environ" ]; then
    env="$(ps -ww -o args= -p "$1" 2>/dev/null) $(tr '\0' ' ' < "/proc/$1/environ" 2>/dev/null)"
  else
    env=$(ps eww -o command= -p "$1" 2>/dev/null || true)
  fi
  case $env in *--dangerously-skip-permissions*) ;; *) miss="$miss bypass-flag" ;; esac
  case $env in *--disallowed-tools=AskUserQuestion*) ;; *) miss="$miss AskUserQuestion-off" ;; esac
  case $env in *" $SKIPVAR=1"*) ;; *) miss="$miss $SKIPVAR" ;; esac
  case $env in *CLAUDE_CODE_CHILD_SESSION=*) miss="$miss nested:CLAUDE_CODE_CHILD_SESSION" ;; esac
  local k  # issue #4: every --env / prelaunch-hook key reached the CLI process
  for k in ${ENVK[@]+"${ENVK[@]}"}; do case $env in *" $k="*) ;; *) miss="$miss env:$k" ;; esac; done
  [ -z "$miss" ]
}

claude_dialog() { # pane -> 2 workspace-trust dialog, 3 Bypass Permissions accept dialog, 1 neither
  local txt
  txt=$(tm capture-pane -p -t "$1" 2>/dev/null || true)
  if printf '%s' "$txt" | grep -q "trust this folder\|one you trust"; then return 2; fi
  if printf '%s' "$txt" | grep -q "Yes, I accept"; then return 3; fi
  return 1
}

proof_claude() { # name sid pane mode
  local name=$1 sid=$2 pane=$3 mode=$4 pid= miss= rc=0
  poll 'pid=$(pgrep -f -- "-n $name .*$sid" 2>/dev/null | head -1 || true); [ -n "$pid" ]' "$PROOF_T" \
    || die "no claude process for $name ($sid) after ${PROOF_T}s; script $STATE/launch/$name.sh; pane $pane"
  # macOS ps can show a just-started process's args before its env (seen once in ~30 test runs),
  # so re-read until every check passes or the proof timeout ends.
  poll 'env_check "$pid"' "$PROOF_T" || true
  [ -z "$miss" ] || die "pid $pid env check failed:$miss; kill $pid and fix $STATE/launch/$name.sh"
  roster_merge "$name" "$(jq -n --argjson p "$pid" '{pid:$p}')"
  # The first prompt is only submitted past the workspace-trust dialog, and the transcript appears then.
  if [ "$mode" != resume ]; then
    poll 'f=$(ls "$HOME"/.claude/projects/*/"$sid".jsonl 2>/dev/null | head -1 || true); [ -n "$f" ] || { claude_dialog "$pane"; case $? in 2) return 2 ;; 3) return 3 ;; esac; false; }' "$PROOF_T" || rc=$?
    case ${rc:-0} in
      0) ;;
      2) die "pid $pid is waiting at Claude's workspace-trust dialog in pane $pane; run: install/claude.sh --trust $(roster_get "$name" dir) --trust-only, then fleet stop $name and relaunch" ;;
      3) die "pid $pid is waiting at Claude's Bypass Permissions accept dialog in pane $pane (seen intermittently even with skipDangerousModePermissionPrompt set); accept it in the pane (fleet attach) or fleet stop $name and relaunch" ;;
      *) die "pid $pid started but its transcript never appeared after ${PROOF_T}s (first prompt not submitted); look at pane $pane" ;;
    esac
  else
    # resume (issue #8): its transcript exists before the resume, so it proves nothing. Watch the pane for the
    # workspace-trust and Bypass Permissions dialogs, and wait for Claude's own registration of this process,
    # <claude home>/sessions/<pid>.json with this pid, which is only written once the session is past both dialogs.
    local reg; reg=$(claude_home)/sessions/$pid.json
    poll 'claude_dialog "$pane"; case $? in 2) return 2 ;; 3) return 3 ;; esac; jq -e --argjson p "$pid" ".pid == \$p" "$reg" >/dev/null 2>&1' "$PROOF_T" || rc=$?
    case ${rc:-0} in
      0) ;;
      2) die "pid $pid is waiting at Claude's workspace-trust dialog in pane $pane (resume); run: install/claude.sh --trust $(roster_get "$name" dir) --trust-only, then fleet stop $name and relaunch" ;;
      3) die "pid $pid is waiting at Claude's Bypass Permissions accept dialog in pane $pane (resume); accept it in the pane (fleet attach) or fleet stop $name and relaunch" ;;
      *) die "pid $pid resumed but never registered $reg after ${PROOF_T}s; look at pane $pane" ;;
    esac
  fi
  if [ "$mode" = goal ]; then
    poll 'f=$(ls "$HOME"/.claude/projects/*/"$sid".jsonl 2>/dev/null | head -1 || true); [ -n "$f" ] && grep -q "Goal set:" "$f"' "$PROOF_T" \
      || die "pid $pid started but no 'Goal set:' in its transcript after ${PROOF_T}s; look at pane $pane"
  fi
}

codex_pane_state() { # pane -> prints trust|ready|wait
  local txt
  txt=$(tm capture-pane -p -t "$1" 2>/dev/null || true)
  if printf '%s' "$txt" | grep -Eqi 'trust (this|the) (folder|directory)|do you trust'; then echo trust
  elif printf '%s' "$txt" | grep -Eq '›|OpenAI Codex|>_'; then echo ready
  else echo wait; fi
}

codex_goal_ok() { # db thread
  [ -f "$1" ] || return 1
  python3 - "$1" "$2" <<'PY'
import sqlite3, sys
try:
    c = sqlite3.connect(sys.argv[1])
    r = c.execute("select status from thread_goals where thread_id=?", (sys.argv[2],)).fetchone()
except Exception:
    r = None
sys.exit(0 if r and r[0] in ("active", "complete") else 1)
PY
}

codex_find_once() { # dir marker -> prints thread id or nothing
  local dir=$1 marker=$2 home=${CODEX_HOME:-$HOME/.codex} files f c id
  files=$(find "$home/sessions" -name 'rollout-*.jsonl' -newer "$marker" 2>/dev/null || true)
  [ -n "$files" ] || return 0
  for f in $(ls -t $files 2>/dev/null); do
    c=$(head -1 "$f" | jq -r '.payload.cwd // empty' 2>/dev/null || true)
    if [ "$c" = "$dir" ]; then
      id=$(head -1 "$f" | jq -r '.payload.id // empty' 2>/dev/null || true)
      if [ -n "$id" ]; then printf '%s' "$id"; return 0; fi
    fi
  done
}

proof_codex() { # name pane dir mode marker
  local name=$1 pane=$2 dir=$3 mode=$4 marker=$5 sid= ui st=wait
  ui=$(min 30 "$PROOF_T")
  poll 'st=$(codex_pane_state "$pane"); [ "$st" != wait ]' "$ui" || die "codex UI not up in pane $pane after ${ui}s"
  if [ "$st" = trust ]; then
    die "codex asks to trust $dir; run: install/codex.sh --trust $dir, then fleet stop $name and launch again"
  fi
  tm send-keys -t "$pane" -l "/rename $name"
  sleep 1; tm send-keys -t "$pane" Enter
  sleep 1; tm send-keys -t "$pane" Enter
  poll 'sid=$(codex_find_once "$dir" "$marker"); [ -n "$sid" ]' "$(min 60 "$PROOF_T")" || true
  if [ -n "$sid" ]; then
    roster_merge "$name" "$(jq -n --arg s "$sid" '{session_id:$s}')"
    if [ "$mode" = goal ]; then
      need python3
      local db=${CODEX_HOME:-$HOME/.codex}/goals_1.sqlite
      poll 'codex_goal_ok "$db" "$sid"' "$PROOF_T" || die "codex goal for $name not active in $db after ${PROOF_T}s; look at pane $pane"
    fi
  elif [ "$mode" = goal ]; then
    die "codex session id for $name not found after launch; cannot prove the goal; look at pane $pane"
  fi
}

proof_opencode() { # name port dir mode
  local name=$1 port=$2 dir=$3 mode=$4 sid=
  need curl
  poll 'sid=$(curl -fsS --max-time 3 "http://127.0.0.1:$port/session" 2>/dev/null | jq -r --arg d "$dir" "[.[]|select(.directory==\$d)]|sort_by(.time.created)|last|.id // empty" 2>/dev/null || true); [ -n "$sid" ]' "$(min 60 "$PROOF_T")" \
    || die "no opencode session for $name on port $port after $(min 60 "$PROOF_T")s"
  roster_merge "$name" "$(jq -n --arg s "$sid" '{session_id:$s}')"
  if [ "$mode" = goal ]; then
    poll 'curl -fsS --max-time 3 "http://127.0.0.1:$port/session" 2>/dev/null | jq -e --arg i "$sid" "[.[]|select(.id==\$i)]|first|((.metadata.goal.state // \"\")==\"active\" or ((.title // \"\")|startswith(\"▶\")))" >/dev/null 2>&1' "$PROOF_T" \
      || die "opencode goal for $name not active after ${PROOF_T}s"
  fi
}

kiro_probe() { # sid KIRO_HOME PANE_PID | user KIRO_HOME SID | goal KIRO_HOME SID -> exit 0 when found (sid prints it)
  python3 - "$@" <<'PY'
import glob, json, os, subprocess, sys
op, home, arg = sys.argv[1], sys.argv[2], sys.argv[3]

def load(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return None  # absent or half-written: not yet

def lines(sid):
    for f in glob.glob(os.path.join(home, "sessions", "*", sid, "messages.jsonl")):
        with open(f, errors="replace") as fh:
            for raw in fh:
                try:
                    yield json.loads(raw)
                except Exception:
                    pass

if op == "sid":
    # The lease pid is Kiro's agent server, a grandchild+ of the pane pid (pane shell -> kiro-cli -> tui -> node).
    out = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True).stdout
    kids = {}
    for row in out.split("\n"):
        f = row.split()
        if len(f) == 2 and f[0].isdigit() and f[1].isdigit():
            kids.setdefault(int(f[1]), []).append(int(f[0]))
    desc, todo = set(), [int(arg)]
    while todo:
        for c in kids.get(todo.pop(), []):
            if c not in desc:
                desc.add(c); todo.append(c)
    found = []
    for lf in glob.glob(os.path.join(home, "session-leases", "*.lease")):
        lease = load(lf)
        if not isinstance(lease, dict) or lease.get("pid") not in desc:
            continue
        sid = os.path.basename(lf)[:-len(".lease")]
        sj = [load(x) for x in glob.glob(os.path.join(home, "sessions", "*", sid, "session.json"))]
        sj = [x for x in sj if isinstance(x, dict)]
        if not sj or any(x.get("rootConversationId") for x in sj):
            continue  # session.json not written yet, or a goal workflow child session (wf-*) holding its own lease
        try:
            found.append((os.path.getmtime(lf), sid))
        except OSError:
            pass
    if not found:
        sys.exit(1)
    print(max(found)[1]); sys.exit(0)

if op == "user":  # a real (non-steer) user turn: the first INPUT was submitted
    for d in lines(arg):
        p = d.get("payload") or {}
        if p.get("type") == "user" and not p.get("source") and isinstance(p.get("content"), str) and p["content"]:
            sys.exit(0)
    sys.exit(1)

if op == "goal":  # parent messages.jsonl: _kiro/workflow/run_start (or run_complete) of workflow "goal"
    for d in lines(arg):
        p = d.get("payload") or {}
        c = p.get("content")
        if not isinstance(c, str) or "_kiro/workflow/run_" not in c:
            continue
        try:
            inner = json.loads(c)  # the marker is a JSON string inside payload.content
        except Exception:
            continue
        if not isinstance(inner, dict) or inner.get("method") not in ("_kiro/workflow/run_start", "_kiro/workflow/run_complete"):
            continue
        wname = inner.get("workflowName") or (inner.get("finalState") or {}).get("workflowName")
        if wname == "goal":
            sys.exit(0)
    sys.exit(1)
sys.exit(2)
PY
}

kiro_trust_dialog() { # pane -> 0 when Kiro's trust-all confirmation (default "No, exit") is on screen
  tm capture-pane -p -t "$1" 2>/dev/null | grep -Eqi 'No, exit|running in trust all tools mode'
}

proof_kiro() { # name pane pane_pid mode resume-sid
  local name=$1 pane=$2 panepid=$3 mode=$4 want=$5 sid= rc=0 kh=${KIRO_HOME:-$HOME/.kiro} t
  need python3
  [ -n "$panepid" ] || die "no pane pid for kiro lane $name (pane $pane)"
  local trustmsg="Kiro trust-all confirmation in pane $pane; run install/kiro.sh (sets chat.disableTrustAllConfirmation) then fleet stop $name and relaunch"
  t=$(min 60 "$PROOF_T")
  poll 'kiro_trust_dialog "$pane" && return 2; sid=$(kiro_probe sid "$kh" "$panepid" 2>/dev/null || true); [ -n "$sid" ]' "$t" || rc=$?
  case $rc in
    0) ;;
    2) die "$trustmsg" ;;
    *) die "no kiro session for $name after ${t}s: no lease in $kh/session-leases held by a descendant of pane pid $panepid (goal child sessions skipped); look at pane $pane" ;;
  esac
  ! kiro_trust_dialog "$pane" || die "$trustmsg"
  if [ "$mode" = resume ] && [ "$sid" != "$want" ]; then
    die "kiro lane $name resumed session $sid, not the requested $want; look at pane $pane"
  fi
  roster_merge "$name" "$(jq -n --arg s "$sid" '{session_id:$s}')"
  if [ "$mode" != resume ]; then
    rc=0
    poll 'kiro_trust_dialog "$pane" && return 2; kiro_probe user "$kh" "$sid"' "$PROOF_T" || rc=$?
    case $rc in
      0) ;;
      2) die "$trustmsg" ;;
      *) die "kiro session $sid for $name has no user turn after ${PROOF_T}s (first prompt not submitted); look at pane $pane" ;;
    esac
  fi
  if [ "$mode" = goal ]; then
    poll 'kiro_probe goal "$kh" "$sid"' "$PROOF_T" \
      || die "kiro goal for $name not started: no goal workflow run_start in $kh/sessions/*/$sid/messages.jsonl after ${PROOF_T}s; look at pane $pane"
  fi
}

agy_settings() { # role.agy.json dir -> per-lane agy --settings JSON on stdout (role keys win; never saved by agy)
  jq --arg d "$2" '{toolPermission:"always-proceed", artifactReviewPolicy:"always-proceed",
    allowNonWorkspaceAccess:true, trustedWorkspaces:[$d]} + .' "$1"
}

agy_screen() { # pane -> 2 trust dialog, 3 first-run onboarding, 4 sign-in wait; 1 none of these
  local s
  s=$(tm capture-pane -p -t "$1" 2>/dev/null || true)
  case $s in
    *"Do you trust the contents"*) return 2 ;;
    *"Choose your color scheme"*|*"Terms of Service"*) return 3 ;;
    *"Waiting for authentication"*) return 4 ;;
  esac
  return 1
}

agy_logged() { # log [want] -> print the conversation id the log names (resume: only when it names want)
  [ -f "$1" ] || return 1
  local id
  if [ -n "${2:-}" ]; then
    grep -Eq "(found|Streaming) conversation $2" "$1" && { printf '%s\n' "$2"; return 0; }
    return 1
  fi
  id=$(grep -Eo 'Created conversation [0-9a-f-]{36}' "$1" | head -1 | awk '{print $3}')
  [ -n "$id" ] && printf '%s\n' "$id"
}

agy_probe() { # user|goal AGY_HOME CID -> exit 0 when the transcript shows it
  python3 - "$@" <<'PY'
import json, os, sys
op, home, cid = sys.argv[1:4]
d = os.path.join(home, "antigravity-cli", "brain", cid, ".system_generated", "logs")
rows = []
for n in ("transcript_full.jsonl", "transcript.jsonl"):
    p = os.path.join(d, n)
    if os.path.exists(p):
        with open(p, errors="replace") as fh:
            for raw in fh:
                try:
                    rows.append(json.loads(raw))
                except ValueError:
                    pass
        break
users = [r for r in rows if r.get("type") == "USER_INPUT"]
if op == "user":  # a submitted prompt AND a model step: the prompt was not just queued behind a startup screen
    sys.exit(0 if users and any(r.get("source") == "MODEL" for r in rows) else 1)
if op == "goal":  # agy expands a typed /goal into the slash-command metadata of the USER_INPUT row
    sys.exit(0 if any("/goal is a [Slash Command]" in (r.get("content") or "") for r in users) else 1)
sys.exit(2)
PY
}

proof_agy() { # name pane mode resume-sid log
  local name=$1 pane=$2 mode=$3 want=$4 log=$5 sid= rc=0 t
  need python3
  local hint2="agy workspace trust dialog in pane $pane; the lane passes trustedWorkspaces in $STATE/launch/$name.agy-settings.json, so check that file, then fleet stop $name and relaunch"
  local hint3="agy first-run screens (color scheme / terms) in pane $pane; run agy once by hand to finish onboarding, then fleet stop $name and relaunch"
  local hint4="agy is waiting for sign-in in pane $pane; run agy once by hand to sign in, then fleet stop $name and relaunch"
  t=$(min 60 "$PROOF_T")
  if [ "$mode" = resume ]; then
    poll 'agy_screen "$pane"; r=$?; [ $r = 1 ] || return $r; sid=$(agy_logged "$log" "$want" || true); [ -n "$sid" ]' "$t" || rc=$?
  else
    poll 'agy_screen "$pane"; r=$?; [ $r = 1 ] || return $r; sid=$(agy_logged "$log" || true); [ -n "$sid" ]' "$t" || rc=$?
  fi
  case $rc in
    0) ;;
    2) die "$hint2" ;;
    3) die "$hint3" ;;
    4) die "$hint4" ;;
    *) if [ "$mode" = resume ]; then die "agy lane $name did not open conversation $want after ${t}s (no 'found conversation $want' in $log); look at pane $pane"
       else die "no agy conversation for $name after ${t}s (no 'Created conversation <uuid>' in $log); look at pane $pane"; fi ;;
  esac
  roster_merge "$name" "$(jq -n --arg s "$sid" '{session_id:$s}')"
  if [ "$mode" = resume ]; then
    # the log names the conversation before the TUI takes input; a wake typed earlier is lost, so wait for the idle footer
    poll 'tm capture-pane -p -t "$pane" 2>/dev/null | grep -qF "? for shortcuts"' "$t" \
      || die "agy lane $name opened conversation $want but its prompt never went idle ('? for shortcuts') after ${t}s; look at pane $pane"
    return 0
  fi
  rc=0
  poll 'agy_screen "$pane"; r=$?; [ $r = 1 ] || return $r; agy_probe user "$AGY_HOME" "$sid"' "$PROOF_T" || rc=$?
  case $rc in
    0) ;;
    2) die "$hint2" ;;
    3) die "$hint3" ;;
    4) die "$hint4" ;;
    *) die "agy conversation $sid for $name has no user turn answered by the model after ${PROOF_T}s; look at pane $pane" ;;
  esac
  if [ "$mode" = goal ]; then
    poll 'agy_probe goal "$AGY_HOME" "$sid"' "$PROOF_T" \
      || die "agy goal for $name not started: no /goal slash-command turn in $AGY_HOME/antigravity-cli/brain/$sid after ${PROOF_T}s; look at pane $pane"
  fi
}

# ---------------------------------------------------------------- other commands
cmd_ls() {
  [ -s "$ROSTER" ] || { echo "(no lanes)"; return 0; }
  local names n pane alive meshes mesh sides
  names=$(jq -r 'keys[]' "$ROSTER")
  # mesh=yes: the lane has the fleet MCP (peer_inbox); no: it reads $FLEET_STATE/inbox/<name>.jsonl by hand
  meshes=$(FLEET_STATE=$STATE python3 "$ROOT/lib/fleet_mesh.py" mesh 2>/dev/null || true)
  # side runs (issue #17): "<parent>\t  -> S1 ..." per running run, printed under the parent's line
  sides=$(FLEET_STATE=$STATE python3 "$ROOT/lib/fleet_side.py" roster 2>/dev/null || true)
  for n in $names; do
    pane=$(roster_get "$n" pane)
    if pane_alive "$pane"; then alive=alive; else alive=dead; fi
    mesh=$(printf '%s\n' "$meshes" | awk -v n="$n" '$1 == n {print $2; exit}')
    printf '%s cli=%s mode=%s pane=%s %s mesh=%s session=%s\n' "$n" "$(roster_get "$n" cli)" "$(roster_get "$n" mode)" \
      "${pane:--}" "$alive" "${mesh:-?}" "$(roster_get "$n" session_id)"
    printf '%s\n' "$sides" | awk -F '\t' -v n="$n" '$1 == n {print $2}'
  done
  FLEET_STATE=$STATE python3 "$ROOT/lib/fleet_side.py" roster --gone 2>/dev/null || true
}

cmd_attach() { tm attach -t "=$SESSION"; }

cmd_layout() {
  tm has-session -t "=$SESSION" 2>/dev/null || { echo "(no tmux session $SESSION)"; return 0; }
  tm list-panes -s -t "=$SESSION:" -F '#{session_name}:#{window_index}.#{pane_index} window=#{window_name} pane=#{pane_id} title=#{pane_title} cmd=#{pane_current_command}'
}

cmd_stop() {
  local name= keep= pane
  while [ $# -gt 0 ]; do
    case $1 in
      --keep-sides) keep=--keep-sides; shift ;;
      -*) die "unknown flag $1" ;;
      *) [ -z "$name" ] || usage; name=$1; shift ;;
    esac
  done
  [ -n "$name" ] || usage
  role_guard stop
  pane=$(roster_get "$name" pane)
  [ -n "$pane" ] || die "no lane named $name in the roster"
  pane_alive "$pane" || die "lane $name has no live pane ($pane)"
  # side runs follow the parent (issue #18): killed, or orphan with --keep-sides; never blocks the stop
  python3 "$ROOT/lib/fleet_side.py" stop-parent "$name" $keep || echo "WARN could not stop side runs of $name" >&2
  tm kill-pane -t "$pane" || die "could not kill pane $pane"
  flog "$name stopped pane=$pane"
  echo "OK stopped $name pane=$pane"
}

# ---- allow-passthrough (v0.8.1): on by default for the whole fleet server, so `fleet show` draws real images
# in every pane. FLEET_DESK_PASSTHROUGH unset or 1: `tmux set-option -g allow-passthrough on` (never off, never
# `all`, never -u). Any other value (0 to opt out): no tmux option call at all. Non-fatal on a tmux without it.
passthrough_apply() {
  [ "${FLEET_DESK_PASSTHROUGH:-1}" = 1 ] || return 0
  tm set-option -g allow-passthrough on 2>/dev/null || echo "WARN could not set allow-passthrough on (tmux older than 3.3?)" >&2
  return 0
}

# ---- status label (issue #44): the fleet session's status-left, session scoped, never -g
status_label_value() { # prints the label to apply (env wins over the file, trailing space kept); rc 1 when none
  if [ -n "${FLEET_STATUS_LABEL:-}" ]; then printf '%s' "$FLEET_STATUS_LABEL"; return 0; fi
  if [ -f "$STATE/status-label" ]; then
    local v; v=$(cat "$STATE/status-label"; printf x); v=${v%x}
    [ -n "$v" ] || return 1
    printf '%s' "$v"; return 0
  fi
  return 1
}
status_label_apply() { # [label] : set status-left and a sized status-left-length on the session; zero tmux calls with no label
  local label rendered w
  if [ $# -ge 1 ]; then label=$1; else label=$(status_label_value; printf x) || true; label=${label%x}; fi
  [ -n "$label" ] || return 0
  tm has-session -t "=$SESSION" 2>/dev/null || return 2
  tm set-option -t "=$SESSION:" status-left "$label" || return 1
  rendered=$(tm display-message -p -t "=$SESSION:" "$label"; printf x) || rendered=x
  rendered=${rendered%x}; rendered=${rendered%$'\n'}
  w=$(printf '%s' "$rendered" | python3 -c 'import sys;print(len(sys.stdin.buffer.read().decode("utf-8","replace")))')
  w=$((w + 1)); [ "$w" -ge 10 ] || w=10
  tm set-option -t "=$SESSION:" status-left-length "$w" || return 1
}
cmd_status_label() {
  need tmux
  case ${1:-} in
    "")
      local saved live
      if [ -f "$STATE/status-label" ]; then saved=$(cat "$STATE/status-label"; printf x); saved=${saved%x}; else saved=none; fi
      [ -n "${FLEET_STATUS_LABEL:-}" ] && printf 'env: %s\n' "$FLEET_STATUS_LABEL"
      printf 'saved: %s\n' "$saved"
      if tm has-session -t "=$SESSION" 2>/dev/null; then live=$(tm show-options -v -t "=$SESSION:" status-left 2>/dev/null; printf x); live=${live%x}; live=${live%$'\n'}; else live="(no session $SESSION)"; fi
      printf 'live: %s\n' "$live" ;;
    --reset)
      [ $# -eq 1 ] || usage
      rm -f "$STATE/status-label"
      if tm has-session -t "=$SESSION" 2>/dev/null; then
        tm set-option -u -t "=$SESSION:" status-left; tm set-option -u -t "=$SESSION:" status-left-length
      fi
      echo "OK status label reset" ;;
    -*) usage ;;
    *)
      [ $# -eq 1 ] || usage
      mkdir -p "$STATE"; printf '%s' "$1" > "$STATE/status-label" || die "could not write $STATE/status-label"
      local rc=0; status_label_apply "$1" || rc=$?
      case $rc in
        0) echo "OK status label saved and applied to $SESSION" ;;
        2) echo "OK status label saved; no tmux session $SESSION yet, it applies on the next launch" ;;
        *) die "could not apply the status label to $SESSION" ;;
      esac ;;
  esac
}

[ $# -ge 1 ] || usage
sub=$1; shift
# `fleet decisions|learn|watch serve` are aliases of the hub (Q700): the hub URL for that tab, or start the hub.
case $sub:${1:-} in
  decisions:serve|learn:serve|watch:serve) shift; exec python3 "$ROOT/lib/fleet_ui.py" alias "$sub" "$@" ;;
esac
case $sub in
  launch) cmd_launch "$@" ;;
  ls) cmd_ls ;;
  attach) cmd_attach ;;
  layout) cmd_layout ;;
  status-label) cmd_status_label "$@" ;;
  stop) cmd_stop "$@" ;;
  decisions) exec python3 "$ROOT/lib/fleet_decisions.py" "$@" ;;  # DECISIONS UI: serve|tui|pick|ask|find|report|refresh
  app) exec python3 "$ROOT/lib/fleet_app.py" "$@" ;;
  ui) exec python3 "$ROOT/lib/fleet_ui.py" "$@" ;;  # the hub: one port, one token, a tab per desk + ROUTE board  # Fleet Desk (Mac app): urls|serve|notify|tunnel|build|open
  send)
    [ $# -ge 2 ] || usage
    exec python3 "$ROOT/lib/fleet_mesh.py" send "${FLEET_NAME:-${FLEET_ROUTE:-ROUTE}}" "$1" "${*:2}" ;;
  listen) exec python3 "$ROOT/lib/fleet_listen.py" "$@" ;;
  show) exec bash "$BINDIR/fleet-show" "$@" ;;  # draw an image in this pane: kitty, block art or text (issue #41)
  desks) role_guard desks; exec bash "$BINDIR/fleet-desks" "$@" ;;
  watch|learn|probe|auth) # desk engines (docs/design/four-desks.md sections 2.5, 3, 4; docs/design/auth-desk.md)
    [ -f "$BINDIR/fleet-$sub" ] || die "fleet-$sub missing"
    exec bash "$BINDIR/fleet-$sub" "$@" ;;
  remote) exec bash "$BINDIR/fleet-remote" "$@" ;;  # phone/tablet attach over ssh+mosh on a private overlay
  bootstrap) role_guard bootstrap; exec bash "$ROOT/bootstrap.sh" "$@" ;;  # new computer: packages, CLIs, ssh PATH, desks, root script (issue #40)
  side) exec python3 "$ROOT/lib/fleet_side.py" "$@" ;;  # side runs: start|end|ls|show (+ later subcommands)
  feed) exec python3 "$ROOT/lib/fleet_feed.py" "$@" ;;  # remote call transcript -> local file for fleet listen (issue #37)
  tick|park|reopen|cleanup|handoff|forget)
    case $sub in
      park|reopen|forget) role_guard "$sub" ;;
      cleanup) case " $* " in *" --apply "*) role_guard cleanup ;; esac ;;
    esac
    [ -f "$BINDIR/fleet-lifecycle" ] || die "fleet-lifecycle missing"
    if [ -x "$BINDIR/fleet-lifecycle" ]; then exec "$BINDIR/fleet-lifecycle" "$sub" "$@"; fi
    exec bash "$BINDIR/fleet-lifecycle" "$sub" "$@" ;;
  update) exec bash "$BINDIR/fleet-update" "$@" ;;  # latest release tag: ff a git checkout, swap a copied tree, relink
  install) # fleet install <claude|codex|opencode|kiro|agy> [installer flags]: run that CLI's installer
    c=${1:-}
    case $c in claude|codex|opencode|kiro|agy) ;; *) die "usage: fleet install claude|codex|opencode|kiro|agy [--dry-run] [--no-desks] ..." ;; esac
    shift; exec bash "$ROOT/install/$c.sh" "$@" ;;
  uninstall) exec bash "$ROOT/install/rules.sh" uninstall "$@" ;;  # take the rules layer out (AGENTS.fleet.md, issue #55)
  rules) exec bash "$ROOT/install/rules.sh" "$@" ;;  # refresh|uninstall|path
  version|--version)
    v=$(git -C "$ROOT" describe --tags --match 'v[0-9]*' 2>/dev/null || true)
    [ -n "$v" ] || { [ -f "$ROOT/VERSION" ] && v=v$(tr -d ' \n' < "$ROOT/VERSION"); }
    echo "${v:-unknown}" ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
