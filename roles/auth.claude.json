{
  "permissions": {
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(fleet launch:*)",
      "Bash(tafk launch:*)",
      "Bash(fleet park:*)",
      "Bash(tafk park:*)",
      "Bash(fleet stop:*)",
      "Bash(tafk stop:*)",
      "Bash(fleet reopen:*)",
      "Bash(tafk reopen:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "AskUserQuestion"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${FLEET_MESH:-}\" ] || python3 \"$FLEET_MESH\" mirror >/dev/null 2>&1; exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
