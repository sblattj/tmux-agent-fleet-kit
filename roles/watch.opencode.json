{
  "description": "Fleet WATCH desk (was listener): turns feed events into messages to DECIDE, never acts",
  "mode": "primary",
  "prompt": "{file:./roles/watch.md}",
  "tools": {
    "write": false,
    "edit": false
  },
  "permission": {
    "bash": {
      "fleet launch*": "deny",
      "tafk launch*": "deny",
      "fleet park*": "deny",
      "tafk park*": "deny",
      "fleet stop*": "deny",
      "tafk stop*": "deny",
      "fleet reopen*": "deny",
      "tafk reopen*": "deny",
      "git commit*": "deny",
      "git push*": "deny"
    }
  }
}
