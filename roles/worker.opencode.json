{
  "description": "Fleet worker: works its goal file, never manages lanes",
  "mode": "primary",
  "prompt": "{file:./roles/worker.md}",
  "tools": {
    "write": true,
    "edit": true
  },
  "permission": {
    "bash": {
      "fleet launch*": "deny",
      "tafk launch*": "deny",
      "fleet park*": "deny",
      "tafk park*": "deny",
      "fleet stop*": "deny",
      "tafk stop*": "deny",
      "fleet reopen*": "deny",
      "tafk reopen*": "deny"
    }
  }
}
