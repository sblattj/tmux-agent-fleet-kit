{
  "name": "fleet-auth",
  "description": "Fleet AUTH desk: owns every login and auth problem, the only session that runs interactive sign-ins. Kiro has no AskUserQuestion equivalent (UNVERIFIED); the role text routes questions.",
  "tools": [
    "*"
  ],
  "includeMcpJson": true,
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "fleet launch*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "tafk launch*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "fleet park*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "tafk park*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "fleet stop*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "tafk stop*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "fleet reopen*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "tafk reopen*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git commit*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git push*"
        ],
        "effect": "deny"
      }
    ]
  }
}
