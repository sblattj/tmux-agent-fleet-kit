{
  "description": "Fleet LEARN desk: keeps the ledger and quizzes the human, writes only through fleet learn",
  "mode": "primary",
  "prompt": "{file:./roles/learn.md}",
  "tools": {
    "write": false,
    "edit": false
  },
  "permission": {
    "bash": {
      "fleet launch*": "deny",
      "tafk launch*": "deny",
      "fleet park*": "deny",
      "tafk park*": "deny",
      "fleet stop*": "deny",
      "tafk stop*": "deny",
      "fleet reopen*": "deny",
      "tafk reopen*": "deny",
      "git commit*": "deny",
      "git push*": "deny"
    }
  }
}
