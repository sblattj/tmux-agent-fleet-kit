#!/usr/bin/env python3
# stub CLI: show a startup dialog picked by the lane name (-n *TRUST* / *BYPASS* / *NOENV* / other), write no
# transcript, stay alive. The name is used because a tmux window does not inherit the launcher's env.
# *REG* (and no dialog): register like Claude past its dialogs, $FLEET_STATE/claude-home/sessions/<pid>.json
# (the tests point FLEET_CLAUDE_HOME there).
# Python, not bash: macOS `ps eww` hides the environment of /bin/bash, and fleet's proof reads it.
import os, sys, time
a = sys.argv[1:]
name = a[a.index("-n") + 1] if "-n" in a else ""
var = "CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS"
if "NOENV" in name and var in os.environ:
    # *NOENV*: re-exec without the skip var, so the launcher's env check must fail for real
    env = {k: v for k, v in os.environ.items() if k != var}
    os.execve(sys.executable, [sys.executable] + sys.argv, env)
if "ENVDROP" in name and any(k.startswith("DROPME_") for k in os.environ):
    # *ENVDROP*: re-exec without DROPME_* vars, so the launcher's --env proof must fail for real (issue #4)
    env = {k: v for k, v in os.environ.items() if not k.startswith("DROPME_")}
    os.execve(sys.executable, [sys.executable] + sys.argv, env)
if "TRUST" in name:
    print("Is this a project you created or one you trust?")
elif "BYPASS" in name:
    print("WARNING: Claude Code running in Bypass Permissions mode\n  No, exit\n  Yes, I accept")
else:
    print("idle")
    if "REG" in name:
        import json
        d = os.path.join(os.environ["FLEET_STATE"], "claude-home", "sessions")
        os.makedirs(d, exist_ok=True)
        sid = a[a.index("--resume") + 1] if "--resume" in a else ""
        with open(os.path.join(d, "%d.json" % os.getpid()), "w") as fh:
            json.dump({"pid": os.getpid(), "sessionId": sid, "name": name}, fh)
sys.stdout.flush()
time.sleep(300)
