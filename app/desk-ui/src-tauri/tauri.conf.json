{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleet Desk",
  "version": "0.1.0",
  "identifier": "dev.fleetkit.desk",
  "build": { "frontendDist": "../shell" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Fleet Desk", "url": "index.html", "width": 1180, "height": 820, "minWidth": 520, "minHeight": 400 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
